    "clean": "node scripts/clean-build-artifacts.mjs",
    "verify": "npm run clean && npm run build"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.5",
    "@supabase/supabase-js": "^2.112.3",
    "astro": "^7.2.1"
