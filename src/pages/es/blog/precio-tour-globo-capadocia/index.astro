---
import LegacySeoArticle from "../../../../components/LegacySeoArticle.astro";
import articles from "../../../../data/legacy-seo-articles.json";
const article = (articles as any[]).find((item) => item.slug === "precio-tour-globo-capadocia" && item.lang === "es");
if (!article) return new Response("Not found", { status: 404 });
---
<LegacySeoArticle article={article} />
