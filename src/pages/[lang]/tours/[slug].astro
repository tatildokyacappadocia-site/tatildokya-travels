---
// Dynamic, database-driven tour page. This ONLY handles slugs that don't
// already have a static file under src/pages/{en,tr,es}/tours/ — Astro
// always prioritizes a matching static route over this dynamic one, so all
// 27 existing tour pages keep working exactly as before, completely
// unaffected by this file. This route exists specifically so that NEW
// tours created from the admin panel go live immediately, with no code
// change or redeploy needed.
export const prerender = false;

import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';

const { lang, slug } = Astro.params;
const VALID_LANGS = ['en', 'tr', 'es'];

if (!lang || !VALID_LANGS.includes(lang) || !slug) {
  return new Response('Not found', { status: 404 });
}

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

async function fetchJson(path: string) {
  if (!SUPABASE_URL || !SUPABASE_KEY) return null;
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
    headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
    cache: 'no-store',
  });
  if (!res.ok) return null;
  return res.json();
}

const products = await fetchJson(
  `products?slug=eq.${encodeURIComponent(slug)}&active=eq.true&select=id,default_price,default_capacity,ask_for_price&limit=1`
);
const product = products?.[0];

if (!product) {
  return new Response('Not found', { status: 404 });
}

const contentRows = await fetchJson(
  `tour_content?product_id=eq.${product.id}&language=eq.${lang}&limit=1`
);
const content = contentRows?.[0];

// If content for this exact language is missing (e.g. admin only filled in
// Turkish so far), fall back to English content rather than a bare 404, so
// the page is never blank while translations are being completed.
const fallbackRows = content ? null : await fetchJson(
  `tour_content?product_id=eq.${product.id}&language=eq.en&limit=1`
);
const finalContent = content || fallbackRows?.[0];

if (!finalContent) {
  return new Response('Not found', { status: 404 });
}

const overviewParagraphs = String(finalContent.overview_html || '')
  .split(/\n\s*\n/)
  .map((p: string) => p.trim())
  .filter(Boolean);

const priceMode = product.ask_for_price ? 'ask' : 'perPerson';

const OVERVIEW_TITLE: Record<string, string> = { en: 'Overview', tr: 'Genel Bakış', es: 'Descripción General' };
const PRICE_TITLE: Record<string, string> = { en: 'Price', tr: 'Fiyat', es: 'Precio' };
const IMPORTANT_TITLE: Record<string, string> = { en: 'Important Information', tr: 'Önemli Bilgiler', es: 'Información Importante' };
---
<StandardizedPrivateTourPage
  lang={lang}
  slug={slug}
  title={finalContent.title}
  heroDesc={finalContent.hero_description}
  overviewTitle={OVERVIEW_TITLE[lang]}
  overviewParagraphs={overviewParagraphs}
  priceTitle={PRICE_TITLE[lang]}
  priceText={finalContent.hero_description}
  included={finalContent.included_items || []}
  importantTitle={IMPORTANT_TITLE[lang]}
  important={finalContent.important_info_items || []}
  faq={finalContent.faq || []}
  duration={finalContent.duration_text || ''}
  mainImage={finalContent.hero_image_url || undefined}
  galleryImages={finalContent.gallery_image_urls || []}
  priceMode={priceMode}
/>
