---
export const prerender = true;
import auditData from '../../data/seo-audit.json';
const audit = auditData as any;
const title = 'SEO Dashboard — Tatildokya Travels';
const legacySummary = audit.legacySummary || {total:0,oldAverageScore:0,preserved:0,redirected:0,needsRedirect:0,missing:0,highValue:0};
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=11" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=11" />
  <style>
    :root{--navy:#0b1f3a;--blue:#17345d;--gold:#e3a800;--bg:#f4f7fb;--line:#dfe7ef;--muted:#64748b;--green:#159447;--red:#d83a3a;--orange:#d97800;--white:#fff}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--navy)}
    .auth-block{min-height:100vh;display:grid;place-items:center;padding:24px}.auth-card{width:min(430px,100%);padding:26px;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 18px 50px #0b1f3a14;text-align:center}.auth-card h1{margin:0 0 8px}.auth-card p{color:var(--muted);font-size:13px}.hidden{display:none!important}
    .page{min-height:100vh}.header{background:linear-gradient(135deg,#081a32,#12345c);color:#fff;padding:26px 24px 30px}.header-inner{width:min(1480px,100%);margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:18px}.back{display:inline-flex;align-items:center;gap:7px;color:#fff;text-decoration:none;font-weight:850;font-size:13px;padding:9px 12px;border:1px solid #ffffff2d;border-radius:10px;background:#ffffff0d}.eyebrow{color:#f6c531;font-size:11px;font-weight:950;letter-spacing:.1em;text-transform:uppercase}.header h1{font-size:32px;margin:8px 0 7px}.header p{margin:0;color:#ced9e8;max-width:850px;line-height:1.6;font-size:13px}.stamp{font-size:11px;color:#9fb0c5;margin-top:9px}
    .wrap{width:min(1480px,calc(100% - 28px));margin:-15px auto 50px}.tabs{display:flex;gap:8px;margin-bottom:14px}.tab-btn{border:1px solid var(--line);background:#fff;color:var(--navy);padding:11px 15px;border-radius:12px;font-weight:900;cursor:pointer;box-shadow:0 6px 20px #0b1f3a0a}.tab-btn.active{background:var(--navy);border-color:var(--navy);color:#fff}.tab-panel.hidden{display:none}
    .summary{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:16px}.metric{background:#fff;border:1px solid var(--line);border-radius:16px;padding:17px;box-shadow:0 9px 25px #0b1f3a0d}.metric small{display:block;color:var(--muted);font-weight:800;margin-bottom:7px}.metric strong{font-size:27px}.metric .sub{font-size:10px;color:var(--muted);margin-top:4px}.score-ring{display:inline-grid;place-items:center;width:52px;height:52px;border-radius:50%;background:conic-gradient(var(--gold) calc(var(--score)*1%),#e9eef5 0);position:relative}.score-ring::after{content:'';position:absolute;inset:6px;border-radius:50%;background:#fff}.score-ring b{position:relative;z-index:1;font-size:13px}
    .panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:0 10px 28px #0b1f3a0b}.panel-title{margin:0 0 4px;font-size:18px}.panel-desc{margin:0 0 14px;color:var(--muted);font-size:11px;line-height:1.55}.filters{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin-bottom:14px}.filters input,.filters select{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 12px;color:var(--navy);font:inherit}.filters input{min-width:280px;flex:1}.legend{margin-left:auto;font-size:11px;color:var(--muted)}
    .table-wrap{overflow:auto}.seo-table{width:100%;border-collapse:separate;border-spacing:0 8px;min-width:1120px}.seo-table th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:#718198;padding:0 10px 5px}.seo-row td,.legacy-row td{background:#f9fbfd;border-top:1px solid #e8edf3;border-bottom:1px solid #e8edf3;padding:12px 10px;font-size:12px;vertical-align:middle}.seo-row td:first-child,.legacy-row td:first-child{border-left:1px solid #e8edf3;border-radius:12px 0 0 12px}.seo-row td:last-child,.legacy-row td:last-child{border-right:1px solid #e8edf3;border-radius:0 12px 12px 0}.route{font-weight:900;color:#0b2e59}.file{font-size:9.5px;color:#8b98a8;margin-top:3px;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.badge{display:inline-flex;align-items:center;justify-content:center;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:950}.excellent{background:#dcf7e7;color:#0f743a}.strong{background:#e1edff;color:#164f98}.improve{background:#fff2c9;color:#8a6200}.weak{background:#ffe0e0;color:#a51f1f}.lang{background:#eef2f7;color:#334b68}.mini-score{font-size:18px;font-weight:950}.miss{max-width:280px;white-space:normal;color:#69798e;line-height:1.45}.open-btn{border:0;background:var(--navy);color:#fff;border-radius:9px;padding:8px 10px;font-weight:900;cursor:pointer;font-size:11px}
    .legacy-preserved{background:#dcf7e7;color:#0f743a}.legacy-redirected{background:#e1edff;color:#164f98}.legacy-needs_redirect{background:#fff2c9;color:#8a6200}.legacy-missing{background:#ffe0e0;color:#a51f1f}.keyword{font-weight:800;color:#334b68;max-width:240px}.target{color:#184e8b;font-weight:800}.legacy-note{font-size:10px;color:#6d7d91;line-height:1.45;max-width:300px}.high-value{box-shadow:inset 4px 0 0 #e3a800}
    dialog{width:min(780px,calc(100% - 26px));max-height:86vh;border:0;border-radius:20px;padding:0;box-shadow:0 28px 80px #0005}.modal{padding:22px}.modal-head{display:flex;justify-content:space-between;gap:15px;align-items:start;border-bottom:1px solid var(--line);padding-bottom:13px;margin-bottom:14px}.modal h2{margin:0;font-size:19px}.close{border:0;width:36px;height:36px;border-radius:50%;font-size:22px;cursor:pointer}.checks{display:grid;grid-template-columns:1fr 1fr;gap:9px}.check{border:1px solid var(--line);border-radius:12px;padding:11px;background:#fafcfe}.check-top{display:flex;justify-content:space-between;gap:10px;font-size:12px;font-weight:900}.ok{color:var(--green)}.bad{color:var(--red)}.tip{font-size:10px;color:var(--muted);line-height:1.45;margin-top:5px}.note{margin-top:15px;padding:11px 13px;border-radius:11px;background:#fff7db;color:#755900;font-size:11px;line-height:1.55}
    @media(max-width:1000px){.summary{grid-template-columns:repeat(2,1fr)}.checks{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.legend{width:100%;margin-left:0}}
    @media(max-width:560px){.summary{grid-template-columns:1fr}.header h1{font-size:26px}.wrap{width:min(100% - 18px,1480px)}.filters input{min-width:100%}.tabs{display:grid;grid-template-columns:1fr}}
  </style>
</head>
<body>
  <section id="authView" class="auth-block"><div class="auth-card"><h1>SEO Dashboard</h1><p>Yönetici oturumu kontrol ediliyor…</p></div></section>
  <section id="dashboard" class="page hidden">
    <header class="header"><div class="header-inner"><div class="top"><div><span class="eyebrow">Tatildokya Travels Admin</span><h1>SEO Güç Dashboard</h1><p>Yeni sitenin SEO gücünü ve eski WordPress / Rank Math çalışmalarının taşınma durumunu aynı ekrandan kontrol edin.</p><div class="stamp">Son analiz: {new Date(audit.summary.generatedAt).toLocaleString('tr-TR')}</div></div><a class="back" href="/admin/">← Admin Panele Dön</a></div></div></header>
    <main class="wrap">
      <div class="tabs">
        <button class="tab-btn active" type="button" data-tab-target="currentSeo">Yeni Site SEO Gücü</button>
        <button class="tab-btn" type="button" data-tab-target="legacySeo">Eski SEO Migration</button>
        <button class="tab-btn" type="button" data-tab-target="technicalSeo">Technical SEO Health</button>
      </div>

      <section id="currentSeo" class="tab-panel">
        <section class="summary">
          <div class="metric"><small>Ortalama SEO Gücü</small><div style={`--score:${audit.summary.averageScore};display:flex;align-items:center;gap:12px`}><span class="score-ring"><b>{audit.summary.averageScore}</b></span><div><strong>{audit.summary.averageScore}/100</strong><div class="sub">Tüm içerik sayfaları</div></div></div></div>
          <div class="metric"><small>Toplam Sayfa</small><strong>{audit.summary.totalPages}</strong><div class="sub">Public Astro route</div></div>
          <div class="metric"><small>90–100</small><strong>{audit.summary.excellent}</strong><div class="sub">Mükemmel</div></div>
          <div class="metric"><small>80–89</small><strong>{audit.summary.strong}</strong><div class="sub">Güçlü</div></div>
          <div class="metric"><small>Geliştirilecek</small><strong>{audit.summary.improve + audit.summary.weak}</strong><div class="sub">80 altı sayfalar</div></div>
        </section>
        <section class="panel">
          <div class="filters"><input id="search" type="search" placeholder="URL veya dosya ara…" /><select id="langFilter"><option value="">Tüm diller</option><option>EN</option><option>TR</option><option>ES</option><option>—</option></select><select id="scoreFilter"><option value="">Tüm skorlar</option><option value="excellent">90–100 Mükemmel</option><option value="strong">80–89 Güçlü</option><option value="improve">65–79 Geliştir</option><option value="weak">0–64 Zayıf</option></select><span class="legend">🟢 90+ &nbsp; 🔵 80+ &nbsp; 🟡 65+ &nbsp; 🔴 &lt;65</span></div>
          <div class="table-wrap"><table class="seo-table"><thead><tr><th>Sayfa</th><th>Dil</th><th>Skor</th><th>Durum</th><th>H1</th><th>İç Link</th><th>ALT</th><th>Eksikler</th><th></th></tr></thead><tbody id="rows">
            {audit.pages.map((p:any,index:number)=><tr class="seo-row" data-index={index} data-route={p.route.toLowerCase()} data-file={p.file.toLowerCase()} data-lang={p.lang} data-status={p.status}><td><div class="route">{p.route}</div><div class="file">{p.file}</div></td><td><span class="badge lang">{p.lang}</span></td><td><span class="mini-score">{p.score}</span>/100</td><td><span class={`badge ${p.status}`}>{p.status==='excellent'?'Mükemmel':p.status==='strong'?'Güçlü':p.status==='improve'?'Geliştir':'Zayıf'}</span></td><td>{p.h1Count}</td><td>{p.internalLinks}</td><td>%{p.altRatio}</td><td><div class="miss">{p.missing.length?p.missing.slice(0,4).join(' • '):'Eksik yok'}</div></td><td><button class="open-btn" type="button" data-open={index}>Detay</button></td></tr>)}
          </tbody></table></div>
        </section>
      </section>

      <section id="legacySeo" class="tab-panel hidden">
        <section class="summary">
          <div class="metric"><small>Eski Rank Math Kayıtları</small><strong>{legacySummary.total}</strong><div class="sub">WordPress export içinden</div></div>
          <div class="metric"><small>Eski Ortalama Skor</small><strong>{legacySummary.oldAverageScore}/100</strong><div class="sub">Rank Math geçmiş puanı</div></div>
          <div class="metric"><small>Korunan + 301 Aktif</small><strong>{legacySummary.preserved + legacySummary.redirected}</strong><div class="sub">{legacySummary.preserved} aynı URL • {legacySummary.redirected} yönlendirme</div></div>
          <div class="metric"><small>301 Gerekli</small><strong>{legacySummary.needsRedirect}</strong><div class="sub">Yeni karşılığı var, eski URL açık değil</div></div>
          <div class="metric"><small>Eksik / İncelenecek</small><strong>{legacySummary.missing}</strong><div class="sub">Yeni karşılık bulunamadı</div></div>
        </section>
        <section class="panel">
          <h2 class="panel-title">Legacy SEO / Old Site Migration</h2>
          <p class="panel-desc">Bu bölüm eski WordPress XML içindeki Rank Math SEO kayıtlarını yeni Astro URL’leriyle karşılaştırır. Sarı satırlar özellikle önemlidir: hedef sayfa var fakat eski URL için aktif 301 bulunmamıştır.</p>
          <div class="filters">
            <input id="legacySearch" type="search" placeholder="Eski URL, keyword veya hedef URL ara…" />
            <select id="legacyStatus">
              <option value="">Tüm migration durumları</option>
              <option value="preserved">Aynı URL Korundu</option>
              <option value="redirected">301 Aktif</option>
              <option value="needs_redirect">301 Gerekli</option>
              <option value="missing">Eksik</option>
            </select>
            <select id="legacyValue">
              <option value="">Tüm eski skorlar</option>
              <option value="high">80+ yüksek değerli SEO</option>
              <option value="mid">50–79</option>
              <option value="low">0–49</option>
            </select>
            <span class="legend">Altın sol çizgi = eski Rank Math skoru 80+</span>
          </div>
          <div class="table-wrap"><table class="seo-table"><thead><tr><th>Eski URL</th><th>Eski Skor</th><th>Focus Keyword</th><th>Yeni Hedef</th><th>Migration</th><th>Açıklama</th></tr></thead><tbody>
            {(audit.legacy||[]).map((l:any)=><tr class:list={["legacy-row",{"high-value":Number(l.rankMathScore)>=80}]} data-legacy-status={l.migrationStatus} data-legacy-score={l.rankMathScore} data-legacy-search={`${l.oldPath} ${l.focusKeyword||''} ${l.currentTarget||''}`.toLowerCase()}><td><div class="route">{l.oldPath}</div><div class="file">{l.title}</div></td><td><span class="mini-score">{l.rankMathScore||0}</span>/100</td><td><div class="keyword">{l.focusKeyword||'—'}</div></td><td><div class="target">{l.currentTarget||l.suggestedTarget||'—'}</div></td><td><span class={`badge legacy-${l.migrationStatus}`}>{l.migrationStatus==='preserved'?'URL Korundu':l.migrationStatus==='redirected'?'301 Aktif':l.migrationStatus==='needs_redirect'?'301 Gerekli':'Eksik'}</span></td><td><div class="legacy-note">{l.note}</div></td></tr>)}
          </tbody></table></div>
        </section>
      </section>
      <section id="technicalSeo" class="tab-panel hidden">
        <section class="summary">
          <div class="metric"><small>Technical SEO Health</small><div style={`--score:${audit.technical?.score||0};display:flex;align-items:center;gap:12px`}><span class="score-ring"><b>{audit.technical?.score||0}</b></span><div><strong>{audit.technical?.score||0}/100</strong><div class="sub">Migration + site health</div></div></div></div>
          <div class="metric"><small>301 Sorunları</small><strong>{audit.technical?.chains?.length||0}</strong><div class="sub">Chain / loop / eksik hedef</div></div>
          <div class="metric"><small>Canonical Sorunları</small><strong>{audit.technical?.canonicalIssues?.length||0}</strong><div class="sub">Eksik veya yanlış canonical</div></div>
          <div class="metric"><small>Kırık İç Link</small><strong>{audit.technical?.brokenLinks?.length||0}</strong><div class="sub">Statik 404 adayları</div></div>
          <div class="metric"><small>Orphan Pages</small><strong>{audit.technical?.orphanPages?.length||0}</strong><div class="sub">İç link almayan sayfalar</div></div>
        </section>
        <section class="panel">
          <h2 class="panel-title">Technical SEO Health</h2>
          <p class="panel-desc">301 → canonical → sitemap → robots → internal links → duplicate content → orphan pages → 404 → schema → image SEO → Core Web Vitals readiness. Bu analiz build-time çalışır; ziyaretçiye ekstra tarama JavaScript'i yüklemez.</p>
          <div class="table-wrap"><table class="seo-table"><thead><tr><th>Kontrol</th><th>Skor</th><th>Durum</th><th>Sorun</th><th>Detay</th></tr></thead><tbody>
            {(audit.technical?.checks||[]).map((c:any)=><tr class="seo-row"><td><div class="route">{c.label}</div></td><td><span class="mini-score">{c.score}</span>/100</td><td><span class={`badge ${c.score>=90?'excellent':c.score>=80?'strong':c.score>=65?'improve':'weak'}`}>{c.provisional?'Ön Değerlendirme':c.score>=90?'Mükemmel':c.score>=80?'Güçlü':c.score>=65?'Geliştir':'Zayıf'}</span></td><td>{c.issues}</td><td><div class="miss">{c.detail}</div></td></tr>)}
          </tbody></table></div>
        </section>

        <section class="panel" style="margin-top:14px">
          <h2 class="panel-title">Öncelikli Teknik Hatalar</h2>
          <p class="panel-desc">Önce kırmızı/sarı kayıtları temizleyin. Dashboard her <code>npm run seo:audit</code>, dev ve build öncesinde yeniden hesaplanır.</p>
          <div class="table-wrap"><table class="seo-table"><thead><tr><th>Tür</th><th>Kaynak / Sayfa</th><th>Problem / Hedef</th></tr></thead><tbody>
            {(audit.technical?.chains||[]).slice(0,40).map((x:any)=><tr class="seo-row"><td><span class="badge weak">301</span></td><td><div class="route">{x.old}</div></td><td><div class="miss">{x.loop?'Redirect loop':!x.targetExists?'Hedef route bulunamadı':`Redirect chain: ${x.chain.join(' → ')}`}</div></td></tr>)}
            {(audit.technical?.canonicalIssues||[]).slice(0,40).map((x:any)=><tr class="seo-row"><td><span class="badge improve">Canonical</span></td><td><div class="route">{x.route}</div></td><td><div class="miss">{x.canonical}</div></td></tr>)}
            {(audit.technical?.brokenLinks||[]).slice(0,40).map((x:any)=><tr class="seo-row"><td><span class="badge weak">404 Link</span></td><td><div class="route">{x.source}</div></td><td><div class="miss">→ {x.target}</div></td></tr>)}
            {(audit.technical?.redirectLinks||[]).slice(0,30).map((x:any)=><tr class="seo-row"><td><span class="badge improve">Internal Link</span></td><td><div class="route">{x.source}</div></td><td><div class="miss">Eski/redirect URL: {x.target} → {x.final}</div></td></tr>)}
            {(audit.technical?.orphanPages||[]).slice(0,30).map((x:any)=><tr class="seo-row"><td><span class="badge improve">Orphan</span></td><td><div class="route">{x}</div></td><td><div class="miss">Başka indexlenebilir sayfadan statik iç link tespit edilmedi.</div></td></tr>)}
          </tbody></table></div>
        </section>

        <section class="panel" style="margin-top:14px">
          <h2 class="panel-title">Duplicate / Schema / Image SEO</h2>
          <div class="table-wrap"><table class="seo-table"><thead><tr><th>Kontrol</th><th>Adet</th><th>Örnek</th></tr></thead><tbody>
            <tr class="seo-row"><td><div class="route">Duplicate Titles</div></td><td>{audit.technical?.duplicateTitles?.length||0}</td><td><div class="miss">{audit.technical?.duplicateTitles?.[0]?.routes?.join(' • ')||'Sorun yok'}</div></td></tr>
            <tr class="seo-row"><td><div class="route">Duplicate Descriptions</div></td><td>{audit.technical?.duplicateDescriptions?.length||0}</td><td><div class="miss">{audit.technical?.duplicateDescriptions?.[0]?.routes?.join(' • ')||'Sorun yok'}</div></td></tr>
            <tr class="seo-row"><td><div class="route">Schema Eksik</div></td><td>{audit.technical?.schemaIssues?.length||0}</td><td><div class="miss">{audit.technical?.schemaIssues?.slice(0,5).join(' • ')||'Sorun yok'}</div></td></tr>
            <tr class="seo-row"><td><div class="route">Image SEO İyileştirme</div></td><td>{audit.technical?.imageIssues?.length||0}</td><td><div class="miss">{audit.technical?.imageIssues?.slice(0,5).map((x:any)=>x.route).join(' • ')||'Sorun yok'}</div></td></tr>
          </tbody></table></div>
        </section>
      </section>

    </main>
  </section>
  <dialog id="detailDialog"><div class="modal"><div class="modal-head"><div><h2 id="modalRoute">SEO Detayı</h2><div id="modalFile" class="file"></div></div><button class="close" id="closeDialog" type="button">×</button></div><div id="modalScore"></div><div class="checks" id="modalChecks"></div><div class="note">Bu skor Google veya Rank Math’ın resmi sıralama puanı değildir. Yeni site skoru teknik/on-page kontrollerden oluşur; Legacy bölümündeki eski skorlar ise WordPress export’undan gelen Rank Math geçmiş puanlarıdır.</div></div></dialog>
  <script id="seo-audit-data" type="application/json" set:html={JSON.stringify(audit.pages)}></script>
  <script src="/src/scripts/seo-dashboard.ts"></script>
</body></html>
