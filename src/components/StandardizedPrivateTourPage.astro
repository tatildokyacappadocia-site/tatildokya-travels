---
import SeoHead from './SeoHead.astro';
import { getTourGallery } from '../utils/tourGallery';

const {
  lang = 'en', slug, title, heroDesc, overviewTitle, overviewParagraphs = [], priceTitle, priceText,
  included = [], importantTitle = 'Important Information', important = [], detailsTitle = 'Tour Details', details = [],
  extraSections = [], faq = [], duration = 'Full Day', rating = '', mainImage, galleryImages = [], priceMode = 'perPerson',
  sidebarBadges = [], sideHighlights = [], reviewCount = 0
} = Astro.props;
const copy = {
  en:{home:'Home',balloon:'Balloon Tours',tours:'Cappadocia Tours',activities:'Activities',private:'Private Tours',transfers:'Transfers',flight:'Flight Status',price:'Tour Price, starting from',perPerson:'per person',group:'per group',ask:'Ask for Price',contact:'Contact via WhatsApp',form:'Quick Reservation Form',formDesc:'Leave your details and our team will contact you as soon as possible.',name:'Full Name',phone:'Phone Number',email:'Email',emailPh:'Email address (optional)',date:'Date',people:'Number of People',selectDate:'Select Date',selectPeople:'Select People',children:'Children are included in this number of people.',message:'Your Message',messagePh:'You can write your additional note.',send:'Send Reservation Request',unit:'Price per person',groupPrice:'Group price',total:'Total price',left:'left',closed:'Closed',sold:'Sold out',loading:'Loading availability...',availability:'Availability',request:'New Reservation Request',alert:'Please complete name, phone, date and number of people before sending.',duration:'Tour Duration',instant:'Instant Confirmation!',terms:'Terms and Conditions',privacyPolicy:'Privacy Policy',cancellation:'Cancellation & Refund Policy',faq:'FAQ'},
  tr:{home:'Ana Sayfa',balloon:'Balon Turları',tours:'Kapadokya Turları',activities:'Aktiviteler',private:'Özel Turlar',transfers:'Transferler',flight:'Uçuş Durumu',price:'Tur Fiyatı, başlayan',perPerson:'kişi başı',group:'grup fiyatı',ask:'Fiyat Sorunuz',contact:'WhatsApp ile İletişim',form:'Hızlı Rezervasyon Formu',formDesc:'Bilgilerinizi bırakın, ekibimiz en kısa sürede sizinle iletişime geçsin.',name:'Ad Soyad',phone:'Telefon Numarası',email:'E-posta',emailPh:'E-posta adresi (opsiyonel)',date:'Tarih',people:'Kişi Sayısı',selectDate:'Tarih Seçin',selectPeople:'Kişi Seçin',children:'Çocuklar da bu kişi sayısına dahildir.',message:'Mesajınız',messagePh:'Ek notunuzu yazabilirsiniz.',send:'Rezervasyon Talebi Gönder',unit:'Kişi başı fiyat',groupPrice:'Grup fiyatı',total:'Toplam fiyat',left:'kaldı',closed:'Kapalı',sold:'Dolu',loading:'Müsaitlik yükleniyor...',availability:'Müsaitlik',request:'Yeni Rezervasyon Talebi',alert:'Lütfen ad, telefon, tarih ve kişi sayısını tamamlayın.',duration:'Tur Süresi',instant:'Anında Onay!',terms:'Kullanım Şartları',privacyPolicy:'Gizlilik Politikası',cancellation:'İptal ve İade Politikası',faq:'SSS'},
  es:{home:'Inicio',balloon:'Tours en Globo',tours:'Tours por Capadocia',activities:'Actividades',private:'Tours Privados',transfers:'Traslados',flight:'Estado del Vuelo',price:'Precio desde',perPerson:'por persona',group:'por grupo',ask:'Consultar Precio',contact:'Contactar por WhatsApp',form:'Formulario de Reserva Rápida',formDesc:'Déjanos tus datos y nuestro equipo te contactará lo antes posible.',name:'Nombre Completo',phone:'Teléfono',email:'Correo electrónico',emailPh:'Correo electrónico (opcional)',date:'Fecha',people:'Número de Personas',selectDate:'Seleccionar Fecha',selectPeople:'Seleccionar Personas',children:'Los niños están incluidos en este número de personas.',message:'Tu Mensaje',messagePh:'Puedes escribir una nota adicional.',send:'Enviar Solicitud de Reserva',unit:'Precio por persona',groupPrice:'Precio del grupo',total:'Precio total',left:'disponibles',closed:'Cerrado',sold:'Agotado',loading:'Cargando disponibilidad...',availability:'Disponibilidad',request:'Nueva Solicitud de Reserva',alert:'Completa nombre, teléfono, fecha y número de personas.',duration:'Duración',instant:'¡Confirmación Instantánea!',terms:'Términos y Condiciones',privacyPolicy:'Política de Privacidad',cancellation:'Política de Cancelación y Reembolso',faq:'Preguntas Frecuentes'}
}[lang] || null;
const tbcCanonicalUrl = `https://tatildokya.com/${lang}/tours/${slug}/`;
const tbcSchemaImage = mainImage || galleryImages[0] || '/images/logo/tatildokya-travels.webp';
const tbcSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const tbcSupabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
let tbcSchemaPrice = 0;
try {
  if (tbcSupabaseUrl && tbcSupabaseKey && slug) {
    const tbcPriceRes = await fetch(
      `${tbcSupabaseUrl}/rest/v1/products?slug=eq.${encodeURIComponent(slug)}&select=default_price,ask_for_price&limit=1`,
      { headers: { apikey: tbcSupabaseKey, Authorization: `Bearer ${tbcSupabaseKey}` } }
    );
    if (tbcPriceRes.ok) {
      const tbcPriceRows = await tbcPriceRes.json();
      const tbcPriceRow = tbcPriceRows?.[0];
      if (tbcPriceRow && !tbcPriceRow.ask_for_price) tbcSchemaPrice = Number(tbcPriceRow.default_price || 0);
    }
  }
} catch (e) {
  // Build-time price fetch failed; the offers block is omitted below rather than
  // shipping a fake 0 EUR price in the Product schema.
}
const tbcProductSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: heroDesc || overviewParagraphs[0] || title,
  image: tbcSchemaImage.startsWith('http') ? tbcSchemaImage : `https://tatildokya.com${tbcSchemaImage}`,
  url: tbcCanonicalUrl,
  brand: { '@type': 'Brand', name: 'Tatildokya Travels' },
  // Note: no per-product aggregateRating here on purpose. The 4.9/1141 TripAdvisor
  // figure is a company-wide total, not a rating of this specific tour — it already
  // appears once, correctly, on the site-wide Organization schema in SeoHead.astro.
  // Repeating it on every Product would misrepresent it as this tour's own review count.
  ...(tbcSchemaPrice > 0 ? { offers: {
    '@type': 'Offer',
    url: tbcCanonicalUrl,
    priceCurrency: 'EUR',
    price: tbcSchemaPrice,
    availability: 'https://schema.org/InStock',
    validFrom: new Date().toISOString().slice(0,10)
  } } : {})
};
const flag = lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧';
const code = lang.toUpperCase();
const imgs = getTourGallery({ slug, title, preferred: [mainImage, ...galleryImages], max: 6 });
const preserveMainPhoto = new Set([
  'photo-shoot-flying-dress-experience',
  'jeep-safari-cappadocia',
  'ihlara-valley-balloons-tour'
]).has(String(slug));
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <SeoHead title={`${title} | Tatildokya Travels`} description={heroDesc || overviewParagraphs[0] || title} lang={lang} />
  <script id="tbc-product-schema" type="application/ld+json" set:html={JSON.stringify(tbcProductSchema)}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'"><noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800;900&display=swap" rel="stylesheet"></noscript>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css" media="print" onload="this.media='all'">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js" defer></script>
  <script src="/js/viewer-count.js" defer></script>
</head>
<body>
<header class="site-header"><div class="header-container">
  <div class="logo"><a href={`/${lang}/`}><img src="/images/logo/tatildokya-travels.webp" alt="Tatildokya Travels" loading="lazy" width="600" height="200" /></a><a class="insta" href="https://www.instagram.com/tatildokyatravel/" target="_blank"><img src="/images/icons/instagram-logo.webp" alt="" loading="lazy" width="24" height="24"/><span>@tatildokyatravel</span></a></div>
  <nav><a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a><a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a><a href={`/${lang}/activities/`}>{copy.activities}</a><a href={`/${lang}/private-tours/`}>{copy.private}</a><a href={`/${lang}/transfers/`}>{copy.transfers}</a></nav>
  <div class="head-right"><div class="lang"><button id="langBtn">{flag} {code} ▾</button><div id="langDrop"><a href={`/en/tours/${slug}`}>🇬🇧 English</a><a href={`/tr/tours/${slug}`}>🇹🇷 Türkçe</a><a href={`/es/tours/${slug}`}>🇪🇸 Español</a></div></div><a class="wa-head" href="https://wa.me/905333925450"><img src="/images/icons/whatsapp-logo.webp" alt="" loading="lazy" width="24" height="24"/>WhatsApp</a><button type="button" class="menu-burger" id="menuBurger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav"><span></span><span></span><span></span></button></div>
</div>
<nav class="mobile-nav" id="mobileNav"><a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a><a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a><a href={`/${lang}/activities/`}>{copy.activities}</a><a href={`/${lang}/private-tours/`}>{copy.private}</a><a href={`/${lang}/transfers/`}>{copy.transfers}</a></nav>
</header>
<main class="page"><div class="container">
  <div class="breadcrumb"><a href={`/${lang}/`}>{copy.home}</a><span>›</span><span>{title}</span></div>
  <section class="hero"><span class="kicker">TATILDOKYA TRAVELS</span><h1>{title}</h1><p>{heroDesc}</p><div class="hero-badges">{rating && <span class="hero-rating"><span class="hero-stars">★★★★★</span><b>{rating}</b>{reviewCount>0 && <><i></i><em>{reviewCount} Reviews</em></>}</span>}<span>⏱ {copy.duration}: {duration}</span><span>⚡ {copy.instant}</span><a class="hero-wa" href="https://wa.me/905333925450" target="_blank" rel="noopener noreferrer"><img src="/images/icons/whatsapp-logo.webp" alt="" width="18" height="18" loading="lazy"/>+90 533 392 54 50</a></div></section>
  {imgs.length>0 && <section class="gallery" data-gallery-root>
    <button class:list={["main-photo", "gallery-click", preserveMainPhoto && "preserve-photo"]} style={preserveMainPhoto ? `--main-photo-bg:url(${JSON.stringify(imgs[0])})` : undefined} type="button" data-gallery-index="0"><img src={imgs[0]} alt={title} width="1200" height="800" loading="lazy" decoding="async" /><span>📁 {imgs.length} {lang==='tr'?'fotoğraf':lang==='es'?'fotos':'photos'}</span></button>
    <div class="side-photos">{imgs.slice(1,5).map((src, i)=> <button type="button" class="gallery-click" data-gallery-index={String(i+1)}><img src={src} alt={title} width="1200" height="800" loading="lazy" decoding="async" /></button>)}</div>
  </section>}
  <div class="gallery-modal" id="galleryModal" aria-hidden="true"><button class="gallery-close" type="button" aria-label="Close">×</button><button class="gallery-prev" type="button" aria-label="Previous">‹</button><img id="galleryModalImg" alt={title} width="1200" height="800" loading="lazy" decoding="async"/><button class="gallery-next" type="button" aria-label="Next">›</button><div class="gallery-count" id="galleryCount"></div></div>
  <div class="grid"><div class="main-col"><section class="card content">
    <section><h2>{overviewTitle}</h2>{overviewParagraphs.map((p)=><p>{p}</p>)}</section>
    <section><h2>{priceTitle}</h2><p>{priceText}</p></section>
    <section><h2>{lang==='tr'?'Fiyata Dahil Olanlar':lang==='es'?'Qué Incluye':'What’s Included'}</h2><div class="checks">{included.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{importantTitle}</h2><div class="checks">{important.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{detailsTitle}</h2>{details.map((p)=><p>{p}</p>)}</section>
    {extraSections.map((s)=><section><h2>{s.title}</h2>{s.paragraphs?.map((p)=><p>{p}</p>)}{s.items && <div class="checks">{s.items.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div>}</section>)}
    {faq.length>0 && <section><h2>{lang==='tr'?'Sıkça Sorulan Sorular':lang==='es'?'Preguntas Frecuentes':'Frequently Asked Questions'}</h2><div class="faq-list">{faq.map((qa)=><details class="faq-item"><summary>{qa.question}</summary><p>{qa.answer}</p></details>)}</div></section>}
  </section></div>
  <aside class="side"><section class="card price-card"><span class="label">{copy.price}</span><div class="price"><del id="mainOldPrice"></del><strong id="mainPrice">{priceMode==='ask'?copy.ask:'—'}</strong><small id="priceSuffix">{priceMode==='perPerson'?copy.perPerson:priceMode==='group'?copy.group:''}</small></div><a id="askPriceLink" class:list={["ask-price-link",priceMode==='ask'&&"show"]} href={`https://wa.me/905333925450?text=${encodeURIComponent(`Hello Tatildokya Travels, please send me a price for ${title}.`)}`}>💬 {copy.ask}</a><div class="badges">{sidebarBadges.map((x)=><span>{x}</span>)}</div><hr/><a class="phone" href="tel:+905333925450">📞 +90 533 392 54 50</a><a class="wa" href="https://wa.me/905333925450"><img src="/images/icons/whatsapp-logo.webp" alt="" loading="lazy" width="24" height="24"/>{copy.contact}</a><div class="side-list">{sideHighlights.map((x)=><div>✓ <span>{x}</span></div>)}</div></section>
  <section class="card booking"><h3>{copy.form}</h3><p>{copy.formDesc}</p><form id="bookingForm"><label>{copy.name}<input id="name" required placeholder={copy.name}/></label><label>{copy.phone}<input id="phone" type="tel" required/></label><label>{copy.email}<input id="email" type="email" placeholder={copy.emailPh}/></label><label>{copy.date}<div class="date-wrap"><input id="date" readonly required placeholder={copy.selectDate}/><button type="button" id="calOpen">📅</button><div id="calendar" class="calendar"><div class="cal-head"><button type="button" id="prev">‹</button><b id="calTitle"></b><button type="button" id="next">›</button></div><div class="week"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div id="days" class="days"></div></div></div></label><label>{copy.people}<select id="people" required><option value="">{copy.selectPeople}</option></select><small class="children">{copy.children}</small></label><div id="priceBox" class="price-box"><div><span id="unitLabel">{priceMode==='group'?copy.groupPrice:copy.unit}</span><b id="unit">—</b></div><div><span>{copy.total}</span><strong id="total">—</strong></div></div><label>{copy.message}<textarea id="message" placeholder={copy.messagePh}></textarea></label><button class="submit">{copy.send}</button></form></section></aside></div>
</div></main>
<footer class="unified-footer"><div class="uf-inner"><div class="uf-logo"><img src="/images/logo/tatildokya-travels-2.webp" alt="Tatildokya Travels" width="600" height="200" loading="lazy" /></div><div class="uf-right"><div class="uf-contacts"><div><img src="/images/icons/telefon-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>Telephone</small><a href="tel:+905333925450">+90 533 392 54 50</a></span></div><div><img src="/images/icons/whatsapp-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>WhatsApp</small><a href="https://wa.me/905333925450">+90 533 392 54 50</a></span></div><div><img src="/images/icons/mail-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>E-Mail</small><a href="mailto:info@tatildokya.com">info@tatildokya.com</a></span></div></div><div class="uf-gallery"><img src="/images/tours/goreme-standart-hot-air-balloon-tour (2).webp" alt="Göreme Standard Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/goreme-comfort-hot-air-balloon-tour (2).webp" alt="Göreme Comfort Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/Ihlara-Valley-Balloons-Tour.webp" alt="Ihlara Valley Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/soganli-valley-balloon-tour (1).webp" alt="Soğanlı Valley Balloon Tour" loading="lazy" width="800" height="600"/></div><div class="uf-social"><a href="https://www.instagram.com/tatildokyatravel/"><img src="/images/icons/instagram-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/>@tatildokyatravel</a><a href="https://www.facebook.com/share/18YZWfn2YZ/?mibextid=wwXIfr"><img src="/images/icons/facebook-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/>Facebook</a></div><nav class="uf-links"><a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a><a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a><a href={`/${lang}/activities/`}>{copy.activities}</a><a href={`/${lang}/faq/`}>{copy.faq}</a><a href={`/${lang}/cancellation-refund-policy/`}>{copy.cancellation}</a><a href={`/${lang}/privacy-policy/`}>{copy.privacyPolicy}</a><a href={`/${lang}/terms-and-conditions/`}>{copy.terms}</a></nav></div></div></footer>
<script define:vars={{slug,lang,priceMode,copy,supabaseUrl,supabaseKey}}>
// Country-code phone selector: initialized first, before anything else in
// this script, so a later error elsewhere can never prevent it from
// registering. (Previously this ran at the bottom of the script — if any
// earlier statement threw, everything below it, including this, silently
// never ran, and the phone field fell back to a plain text input with no
// country flag/dial-code picker.)
let iti=null;
document.addEventListener('DOMContentLoaded',()=>{if(window.intlTelInput){iti=window.intlTelInput(document.getElementById('phone'),{initialCountry:'tr',separateDialCode:true,nationalMode:false,preferredCountries:['tr','us','gb','de','fr','es']})}});
const URL=supabaseUrl, KEY=supabaseKey;
const TBC_TODAY_CUTOFF_HOUR=10; // private/custom tours start ~10am Turkey time; today no longer bookable after this
function tbcTurkeyNow(){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Istanbul',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',hour12:false}).formatToParts(new Date());const o=Object.fromEntries(parts.map(p=>[p.type,p.value]));return{y:Number(o.year),m:Number(o.month)-1,d:Number(o.day),h:Number(o.hour)}}
let runtimePriceMode=priceMode;
const $=id=>document.getElementById(id); const months=lang==='tr'?['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık']:lang==='es'?['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']:['January','February','March','April','May','June','July','August','September','October','November','December'];
let product=null, availability={}, selected=null, selKey='', cm=new Date().getMonth(), cy=new Date().getFullYear();
const pad=n=>String(n).padStart(2,'0'), key=(y,m,d)=>`${y}-${pad(m+1)}-${pad(d)}`, display=k=>{const [y,m,d]=k.split('-');return `${d}.${m}.${y}`}, money=v=>`${Number(v||0).toLocaleString(lang==='tr'?'tr-TR':lang==='es'?'es-ES':'en-US',{maximumFractionDigits:2})} €`, rem=r=>Math.max(Number(r?.capacity||0)-Number(r?.booked||0),0);
async function get(path){const r=await fetch(`${URL}/rest/v1/${path}`,{headers:{apikey:KEY,Authorization:`Bearer ${KEY}`}});if(!r.ok)throw new Error(await r.text());return r.json()}
function effective(k){return availability[k]||{date:k,price:Number(product?.default_price||0),capacity:Number(product?.default_capacity||0),booked:0,status:'available',_default:true}}
function available(r){return r&&r.status==='available'&&Number(r.capacity)>0&&rem(r)>0}
async function loadProduct(){if(!URL||!KEY)return;const rows=await get(`products?slug=eq.${encodeURIComponent(slug)}&active=eq.true&select=id,default_price,default_capacity,ask_for_price&limit=1`);product=rows[0]||null;if(!product)return;if(product.ask_for_price)runtimePriceMode='ask';const schemaTag=document.getElementById('tbc-product-schema');if(runtimePriceMode==='ask'){$('mainPrice').textContent=copy.ask;const old=$('mainOldPrice');if(old){old.textContent='';old.classList.remove('has-price')}const suf=$('priceSuffix');if(suf)suf.style.display='none';$('askPriceLink')?.classList.add('show');if(schemaTag){try{const data=JSON.parse(schemaTag.textContent);delete data.offers;schemaTag.textContent=JSON.stringify(data);}catch(e){}}}if(runtimePriceMode!=='ask'){const manual=Number(product.default_price||0);$('mainPrice').textContent=manual>0?money(manual):'—';const old=$('mainOldPrice');if(old){if(manual>0){old.textContent=money(Math.round(manual*1.30));old.classList.add('has-price')}else{old.textContent='';old.classList.remove('has-price')}}if(manual>0&&schemaTag){try{const data=JSON.parse(schemaTag.textContent);data.offers=data.offers||{'@type':'Offer',url:location.href,priceCurrency:'EUR',availability:'https://schema.org/InStock',validFrom:new Date().toISOString().slice(0,10)};data.offers.price=manual;schemaTag.textContent=JSON.stringify(data);}catch(e){}}}}
async function loadMonth(){if(!product){$('days').innerHTML=`<div class="msg">${copy.availability}</div>`;return}const first=`${cy}-${pad(cm+1)}-01`,ld=new Date(cy,cm+1,0).getDate(),last=`${cy}-${pad(cm+1)}-${pad(ld)}`;const rows=await get(`availability?product_id=eq.${product.id}&date=gte.${first}&date=lte.${last}&select=date,price,capacity,booked,status`);availability={};rows.forEach(r=>availability[r.date]=r);render()}
function render(){$('days').innerHTML='';$('calTitle').textContent=`${months[cm]} ${cy}`;let off=new Date(cy,cm,1).getDay();off=off===0?6:off-1;for(let i=0;i<off;i++)$('days').insertAdjacentHTML('beforeend','<button class="day empty" disabled></button>');const last=new Date(cy,cm+1,0).getDate();for(let d=1;d<=last;d++){const k=key(cy,cm,d),r=effective(k),tn=tbcTurkeyNow(),pastDay=new Date(cy,cm,d).getTime()<new Date(tn.y,tn.m,tn.d).getTime(),pastCutoff=cy===tn.y&&cm===tn.m&&d===tn.d&&tn.h>=TBC_TODAY_CUTOFF_HOUR,past=pastDay||pastCutoff,ok=!past&&available(r),b=document.createElement('button');b.type='button';b.className=`day ${ok?'':'disabled'} ${k===selKey?'selected':''}`;b.disabled=!ok;const status=past?'':r.status==='closed'?copy.closed:rem(r)<=0?copy.sold:`${rem(r)} ${copy.left}`;b.innerHTML=`<b>${d}</b>${(runtimePriceMode==='ask'||past)?'':`<span>${money(r.price)}</span>`}<small>${status}</small>`;if(ok)b.onclick=()=>choose(r,k);$('days').appendChild(b)}}
