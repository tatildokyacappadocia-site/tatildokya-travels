---
// Tüm turlarda ortak kullanılan "Reviews" modalı — gerçek Google/TripAdvisor
// yorumlarımıza (src/data/guestReviews.ts) dayanır. Hiçbir sahte platform veya
// uydurma sayı içermez: sadece gerçekten sahip olduğumuz Google + TripAdvisor
// yorumlarını gösterir.
import { guestReviews } from "../data/guestReviews";

const { lang = "en" } = Astro.props;

const googleCount = guestReviews.filter((r) => r.source === "google").length;
const taCount = guestReviews.filter((r) => r.source === "tripadvisor").length;
const starBreakdown = [5, 4, 3, 2, 1].map((star) => ({
  star,
  count: guestReviews.filter((r) => r.rating === star).length,
}));

const t = {
  en: { eyebrow: "HIGHLIGHTED REVIEWS", reviews: "Reviews", stars: "Stars" },
  tr: { eyebrow: "ÖNE ÇIKAN YORUMLAR", reviews: "Yorum", stars: "Yıldız" },
  es: { eyebrow: "RESEÑAS DESTACADAS", reviews: "Reseñas", stars: "Estrellas" },
}[lang] || { eyebrow: "HIGHLIGHTED REVIEWS", reviews: "Reviews", stars: "Stars" };
---

<div class="tbc-reviews-modal-overlay" id="tbcReviewsOverlay" hidden>
  <div class="tbc-reviews-modal" role="dialog" aria-modal="true" aria-labelledby="tbcReviewsModalTitle">
    <button type="button" class="tbc-reviews-close" id="tbcReviewsClose" aria-label="Close">✕</button>

    <div class="tbc-reviews-modal-header">
      <span class="tbc-reviews-eyebrow">{t.eyebrow}</span>
      <h3 id="tbcReviewsModalTitle">Tatildokya Travels</h3>
    </div>

    <div class="tbc-reviews-platforms">
      <a class="tbc-reviews-platform-card" href="https://share.google/o3AA8wroDMV8i7DEI" target="_blank" rel="noopener noreferrer">
        <img src="/images/icons/google-logo.webp" alt="Google" width="28" height="28" loading="lazy" />
        <strong>Google</strong>
        <span>({googleCount}+ {t.reviews})</span>
        <span class="tbc-reviews-platform-rating">⭐ 4.9</span>
      </a>
      <a class="tbc-reviews-platform-card" href="https://www.tripadvisor.com/Attraction_Review-g297983-d19185861-Reviews-Tatildokya_Travel_Turkey-Goreme_Nevsehir_Province_Cappadocia.html" target="_blank" rel="noopener noreferrer">
        <img src="/images/icons/tripadvisor-logo.webp" alt="TripAdvisor" width="28" height="28" loading="lazy" />
        <strong>TripAdvisor</strong>
        <span>({taCount}+ {t.reviews})</span>
        <span class="tbc-reviews-platform-rating">⭐ 4.9</span>
      </a>
      <div class="tbc-reviews-star-breakdown">
        {starBreakdown.map((row) => (
          <div class="tbc-reviews-star-row">
            <span>{"★".repeat(row.star)}{"☆".repeat(5 - row.star)}</span>
            <b>{row.count}</b>
          </div>
        ))}
      </div>
    </div>

    <div class="tbc-reviews-list">
      {guestReviews.map((review) => (
        <div class="tbc-reviews-item">
          <div class="tbc-reviews-avatar">{review.name.charAt(0).toUpperCase()}</div>
          <div class="tbc-reviews-item-body">
            <div class="tbc-reviews-item-top">
              <strong>{review.name}</strong>
              <span class="tbc-reviews-item-date">{review.date} · {review.source === "google" ? "Google" : "TripAdvisor"}</span>
            </div>
            <div class="tbc-reviews-item-stars">{"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)} <span>({review.rating} {t.stars})</span></div>
            <p>{review.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  (() => {
    const overlay = document.getElementById("tbcReviewsOverlay");
    const closeBtn = document.getElementById("tbcReviewsClose");
    if (!overlay || !closeBtn) return;

    const openModal = () => {
      overlay.hidden = false;
      overlay.classList.add("is-open");
      document.body.style.overflow = "hidden";
    };
    const closeModal = () => {
      overlay.hidden = true;
      overlay.classList.remove("is-open");
      document.body.style.overflow = "";
    };

    document.querySelectorAll("[data-open-reviews]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        openModal();
      });
    });

    closeBtn.addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  })();
</script>

<style>
  .tbc-reviews-modal-overlay { display: none; position: fixed; inset: 0; z-index: 5000; background: rgba(10,24,48,.55); align-items: center; justify-content: center; padding: 20px; }
  .tbc-reviews-modal-overlay.is-open { display: flex; }
  .tbc-reviews-modal { position: relative; width: 100%; max-width: 640px; max-height: 86vh; background: #fff; border-radius: 22px; padding: 28px 26px 26px; overflow-y: auto; box-shadow: 0 30px 80px rgba(0,0,0,.35); font-family: 'Inter', Arial, sans-serif; }
  .tbc-reviews-close { position: absolute; top: 18px; right: 18px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid #e5eef7; background: #f7fafd; font-size: 15px; color: #0a1830; cursor: pointer; }
  .tbc-reviews-modal-header { margin-bottom: 18px; }
  .tbc-reviews-eyebrow { display: block; font-size: 11px; font-weight: 900; letter-spacing: .08em; color: #5c7797; margin-bottom: 4px; }
  .tbc-reviews-modal-header h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 800; color: #1478d4; margin: 0; }

  .tbc-reviews-platforms { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 22px; }
  .tbc-reviews-platform-card { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; background: #f7fafd; border: 1px solid #e5eef7; border-radius: 16px; padding: 16px 10px; text-decoration: none; color: #0a1830; transition: border-color .15s ease, transform .15s ease; }
  .tbc-reviews-platform-card:hover { border-color: #1478d4; transform: translateY(-2px); }
  .tbc-reviews-platform-card strong { font-size: 13px; font-weight: 800; }
  .tbc-reviews-platform-card span { font-size: 11px; color: #5c7797; }
  .tbc-reviews-platform-rating { color: #0a1830 !important; font-weight: 800; }
  .tbc-reviews-star-breakdown { display: flex; flex-direction: column; justify-content: center; gap: 4px; background: #f7fafd; border: 1px solid #e5eef7; border-radius: 16px; padding: 10px 14px; }
  .tbc-reviews-star-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 10px; color: #eab308; }
  .tbc-reviews-star-row b { color: #5c7797; font-weight: 700; }

  .tbc-reviews-list { display: flex; flex-direction: column; gap: 14px; }
  .tbc-reviews-item { display: flex; gap: 12px; background: #f7fafd; border: 1px solid #e5eef7; border-radius: 16px; padding: 14px 16px; }
  .tbc-reviews-avatar { flex: 0 0 40px; width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#2f8ee0,#0d5aa0); color: #fff; font-weight: 800; font-size: 16px; display: flex; align-items: center; justify-content: center; }
  .tbc-reviews-item-body { flex: 1; min-width: 0; }
  .tbc-reviews-item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .tbc-reviews-item-top strong { font-size: 13.5px; color: #0a1830; }
  .tbc-reviews-item-date { font-size: 11px; color: #5c7797; white-space: nowrap; }
  .tbc-reviews-item-stars { color: #eab308; font-size: 12px; margin: 4px 0 6px; }
  .tbc-reviews-item-stars span { color: #5c7797; font-size: 11px; }
  .tbc-reviews-item-body p { margin: 0; font-size: 13px; line-height: 1.55; color: #334255; }

  @media (max-width: 640px) {
    .tbc-reviews-modal { padding: 22px 16px 20px; border-radius: 18px; }
    .tbc-reviews-platforms { grid-template-columns: 1fr 1fr; }
    .tbc-reviews-star-breakdown { grid-column: 1 / -1; }
  }
</style>
