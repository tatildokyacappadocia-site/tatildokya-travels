---
import GoogleAdsTag from './GoogleAdsTag.astro';
const { article } = Astro.props;
const siteOrigin = "https://tatildokya.com";
const lang = ["tr", "es"].includes(article.lang) ? article.lang : "en";
// Cannibalization fix (2026-08-20): these 3 legacy articles target the same
// search intent as "cappadocia-balloon-tour-price" (same head keyword, near-
// identical title/meta). Rather than delete/redirect real, unique content,
// they canonicalize to the strongest/most recent article of the group so
// Google consolidates ranking signal there instead of splitting it 4 ways.
// The pages stay live and fully readable; only the canonical hint changes.
const CANONICAL_OVERRIDES: Record<string, string> = {
  "air-balloon-cappadocia-price": "/en/blog/cappadocia-balloon-tour-price/",
  "air-balloon-in-cappadocia-price": "/en/blog/cappadocia-balloon-tour-price/",
  "balloon-flight-cappadocia-cost": "/en/blog/cappadocia-balloon-tour-price/",
};
const canonical = `${siteOrigin}${CANONICAL_OVERRIDES[article.slug] || article.newPath}`;
const homeUrl = `/${lang}/`;
const balloonUrl = `/${lang}/balloon-tours/`;
const toursUrl = `/${lang}/cappadocia-tours/`;
const flightUrl = `/${lang}/flight-status/`;
const blogUrl = `/${lang}/blog/`;
const activitiesUrl = `/${lang}/activities/`;
const privateUrl = `/${lang}/private-tours/`;
const transfersUrl = `/${lang}/transfers/`;
const heroImages = {
  "1-gunluk-kapadokya-turlari": "/images/tours/cappadocia-tour.webp",
  "air-balloon-cappadocia-price": "/images/gallery/cappadocia-fairy-chimneys-balloons.webp",
  "air-balloon-in-cappadocia-price": "/images/gallery/cappadocia-balloon-sunrise-silhouette.webp",
  "air-balloon-ride-turkey": "/images/blog/cappadocia-balloon-launch-field-aerial.webp",
  "antalya-to-cappadocia-turkey-distance": "/images/tours/kayseri-airport-shuttle-transfer.webp",
  "balloon-flight-cappadocia-cost": "/images/blog/cappadocia-striped-balloon-sunrise.webp",
  "balloons-of-cappadocia-travel-agency": "/images/tours/cappadocia-sunset-camel-riding-tour (4).webp",
  "balon-dahil-kapadokya-turu": "/images/tours/Red-Tour-Cappadocia.webp",
  "balon-fiyatlari-kapadokya": "/images/blog/cappadocia-balloon-sunrise-launch.webp",
  "best-balloon-flights-in-cappadocia": "/images/tours/goreme-standart-hot-air-balloon-tour (10).webp",
  "best-cappadocia-day-tour-from-turkey": "/images/tours/Blue-Tour-Cappadocia-Discover-Hidden-Valleys.webp",
  "best-cappadocia-green-tour": "/images/tours/Private-Green-Tour-Cappadocia.webp",
  "best-hot-air-balloons-cappadocia": "/images/tours/goreme-comfort-hot-air-balloon-tour (6).webp",
  "cappadocia-turkey-holidays": "/images/tours/cappadocia-jeep-safari (14).webp",
  "istanbul-cappadocia-tours-turkey": "/images/tours/Nevsehir-Airport-NAV-Shuttle-Transfer.webp",
  "cappadocia-balloon-tour-price": "/images/tours/goreme-standart-hot-air-balloon-tour (11).webp"
};
const heroImage = heroImages[article.slug] || "/images/tours/soganli-valley-balloon-tour (2).webp";
const socialImage = `${siteOrigin}${heroImage}`;
const labels = lang === "tr" ? {
  balloon:"Balon Turları", tours:"Kapadokya Turları", flight:"Uçuş Durumu", blog:"Blog",
  activities:"Aktiviteler", private:"Özel Turlar", transfers:"Transferler",
  migrated:"SEO Rehberi", updated:"Güncellenmiş rehber", related:"Kapadokya'yı planlayın",
  cta:"Kapadokya deneyiminizi planlayın", ctaText:"Balon uçuşları, günlük turlar ve güncel uçuş durumunu tek yerden inceleyin.",
  back:"Tüm rehberler", whatsapp:"WhatsApp ile Sor"
} : lang === "es" ? {
  balloon:"Tours en Globo", tours:"Tours por Capadocia", flight:"Estado de Vuelo", blog:"Blog",
  activities:"Actividades", private:"Tours Privados", transfers:"Traslados",
  migrated:"Guía de Viaje SEO", updated:"Guía actualizada", related:"Planifica tu viaje a Capadocia",
  cta:"Planifica tu experiencia en Capadocia", ctaText:"Compara vuelos en globo, tours diarios e información de vuelo en tiempo real en un solo lugar.",
  back:"Todas las guías", whatsapp:"Preguntar por WhatsApp"
} : {
  balloon:"Balloon Tours", tours:"Cappadocia Tours", flight:"Flight Status", blog:"Blog",
  activities:"Activities", private:"Private Tours", transfers:"Transfers",
  migrated:"SEO Travel Guide", updated:"Updated guide", related:"Plan your Cappadocia trip",
  cta:"Plan your Cappadocia experience", ctaText:"Compare balloon flights, daily tours and live flight-status information in one place.",
  back:"All travel guides", whatsapp:"Ask on WhatsApp"
};
const schema = {
  "@context":"https://schema.org",
  "@type":"Article",
  "headline":article.title,
  "description":article.description,
  "mainEntityOfPage":canonical,
  "url":canonical,
  "image":socialImage,
  "datePublished":article.published || undefined,
  "dateModified":"2026-08-15",
  "inLanguage":lang,
  "author":{"@type":"Organization","name":"Tatildokya Travels","url":siteOrigin},
  "publisher":{"@type":"Organization","name":"Tatildokya Travels","url":siteOrigin,"logo":{"@type":"ImageObject","url":`${siteOrigin}/images/logo/tatildokya-travels.webp`}}
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{article.seoTitle}</title>
  <meta name="description" content={article.description} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  {article.focusKeyword && <meta name="keywords" content={article.focusKeyword} />}
  <!-- Tatildokya Travels favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=11" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=11" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=11" />
  <link rel="shortcut icon" href="/favicon.ico?v=11" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=11" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={article.seoTitle} />
  <meta property="og:description" content={article.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={article.seoTitle} />
  <meta name="twitter:description" content={article.description} />
  <meta name="twitter:image" content={socialImage} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <style>
    :root{--navy:#07274e;--navy2:#10345f;--gold:#146ad4;--bg:#ebf0f6;--ink:#26374c;--muted:#6b7c90;--line:#d4dde8}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}
    a{color:inherit}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #e7ebf0;box-shadow:0 5px 18px #07274e0a}
    .crumb{width:min(1180px,calc(100% - 32px));margin:18px auto 0;font-size:11px;color:#728296}.crumb a{text-decoration:none;color:#4b6380}.hero{width:min(1180px,calc(100% - 32px));margin:14px auto 0;padding:clamp(26px,4vw,48px);border:1px solid var(--line);border-radius:24px;background:radial-gradient(circle at 95% 0,#bbd7f9 0,transparent 24rem),#fff;box-shadow:0 18px 45px #07274e12}.kicker{display:inline-flex;padding:7px 11px;border-radius:999px;background:#1372e6;color:#102a4a;font-size:10px;font-weight:950;letter-spacing:.05em}.hero h1{margin:13px 0 12px;color:var(--navy);font-size:clamp(31px,4vw,52px);line-height:1.07;letter-spacing:-.035em;max-width:980px}.hero p{max-width:900px;margin:0;color:#5c6e83;font-size:16px;line-height:1.75}.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.meta span{padding:7px 10px;border-radius:999px;background:#f5f8fb;border:1px solid #e1e7ee;color:#4f6178;font-size:11px;font-weight:750}
    .hero-image{width:min(1180px,calc(100% - 32px));height:clamp(260px,37vw,480px);margin:16px auto 0;border-radius:24px;overflow:hidden;border:1px solid var(--line);background:#dadde0}.hero-image img{width:100%;height:100%;object-fit:cover;display:block}
    .layout{width:min(1180px,calc(100% - 32px));margin:18px auto 50px;display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:20px;align-items:start}.article{background:#fff;border:1px solid var(--line);border-radius:24px;padding:clamp(24px,4vw,42px);box-shadow:0 14px 38px #07274e0b}.article :global(h2){color:var(--navy);font-size:clamp(23px,2.5vw,32px);line-height:1.2;margin:36px 0 13px;padding-top:22px;border-top:1px solid #dae3ee}.article :global(h3){color:#143a69;font-size:20px;margin:28px 0 10px}.article :global(p),.article :global(li){font-size:15px;line-height:1.9;color:#4f6178}.article :global(ul),.article :global(ol){padding-left:23px}.article :global(a){color:#0d52a6;font-weight:700;text-decoration-thickness:1px;text-underline-offset:3px}.article :global(strong){color:#243851}.article :global(table){width:100%;border-collapse:collapse;display:block;overflow:auto}.article :global(th),.article :global(td){border:1px solid #e0e6ed;padding:9px}.article :global(.article-media){margin:28px 0}.article :global(.article-media img){width:100%;height:auto;max-height:460px;object-fit:cover;display:block;border-radius:18px;border:1px solid var(--line)}.article :global(.article-media figcaption){margin-top:8px;color:#77879a;font-size:11px;line-height:1.55}.article :global(.article-related){margin:18px 0 26px;padding:14px 16px;border:1px solid #dce7f5;border-radius:14px;background:#eaf3fd;color:#52647a;font-size:12px;line-height:1.75}.article :global(.article-related strong){color:var(--navy);margin-right:5px}.article :global(.article-related a){font-size:12px}.article :global(.article-link){margin:10px 0 18px}.article :global(.article-link a){display:inline-flex;padding:10px 13px;border-radius:12px;background:#f8fbfe;border:1px solid #dfe8f2;color:#0d52a6;font-size:13px;font-weight:800;text-decoration:none}.article :global(.article-link a:hover){border-color:#146ad4;background:#e6f0fd}
    .sidebar{display:grid;gap:14px;position:sticky;top:104px}.side-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 12px 32px #07274e0a}.side-card h2{margin:0 0 8px;color:var(--navy);font-size:19px}.side-card p{margin:0 0 14px;font-size:12px;line-height:1.65;color:#6c7c90}.side-links{display:grid;gap:8px}.side-links a{padding:11px 12px;border-radius:12px;background:#f8fbfe;border:1px solid #e0e8f1;text-decoration:none;font-size:12px;font-weight:850;color:#0b3568}.side-links a:hover{border-color:#146ad4;background:#e6f0fd}.cta{background:linear-gradient(135deg,#07274e,#123b6d);color:#fff;border-color:#123b6d}.cta h2{color:#fff}.cta p{color:#d8e2ef}.cta a{display:flex;justify-content:center;padding:12px;border-radius:999px;background:#18b965;color:#fff;text-decoration:none;font-size:12px;font-weight:900}
    .footer{background:#fff;border-top:1px solid #e3e8ee;padding:28px 16px;text-align:center;color:#6c7b8d;font-size:11px}.assistant{position:fixed;right:22px;bottom:22px;z-index:30;display:flex;align-items:center;gap:9px;padding:11px 16px;border-radius:999px;background:#082d5b;color:#fff;text-decoration:none;font-weight:900;font-size:12px;box-shadow:0 16px 40px #07274e38}.assistant img{width:22px;height:22px}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.sidebar{position:static}}@media(max-width:560px){.hero,.article{border-radius:18px}.hero{padding:24px 18px}.article{padding:24px 18px}.hero-image{height:230px;border-radius:18px}.assistant{right:13px;bottom:13px}}
    .uh-header{position:sticky;top:0;z-index:1200;background:#fff;border-bottom:1px solid #e6ecf4}
    .uh-header .header-container{max-width:1320px;height:88px;margin:auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:18px}
    .uh-header .logo,.uh-header .head-right,.uh-header .insta,.uh-header .wa-head{display:flex;align-items:center}
    .uh-header .logo>a:first-child img{width:auto!important;height:70px!important;max-width:145px!important;object-fit:contain!important;display:block}
    .uh-header .insta{gap:6px;margin-left:12px;padding:7px 10px;border:1px solid #e4eaf1;border-radius:99px;text-decoration:none;color:#30445d;font-size:10px;font-weight:700}
    .uh-header .insta img,.uh-header .wa-head img{width:20px;height:20px;object-fit:contain}
    .uh-header nav.uh-nav{display:flex;gap:20px}
    .uh-header nav.uh-nav a{font-size:12px;font-weight:800;color:#0a1726;text-decoration:none}
    .uh-header .head-right{gap:12px}
    .uh-header .wa-head{gap:6px;color:#0a1726;text-decoration:none;font-weight:800;font-size:12px}
    .uh-header .lang{position:relative}
    .uh-header .lang button{border:1px solid #cbd5e1;background:#f8fafc;border-radius:99px;padding:7px 12px;font-weight:800;font-size:12px;white-space:nowrap;display:inline-flex;align-items:center;gap:4px}
    .uh-header .lang>div{display:none;position:absolute;right:0;top:42px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:6px;min-width:150px;box-shadow:0 14px 30px #0002}
    .uh-header .lang.open>div{display:grid}
    .uh-header .lang>div a{padding:8px;text-decoration:none;color:#071e3b;border-radius:8px}
    .uh-header .lang>div a:hover{background:#f1f5f9}
    .uh-header .menu-burger{display:none;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;border:1px solid #cbd5e1;background:#f8fafc;border-radius:10px;cursor:pointer;padding:0}
    .uh-header .menu-burger span{display:block;width:18px;height:2px;margin:0 auto;background:#0a1726;border-radius:2px;transition:transform .2s ease,opacity .2s ease}
    .uh-header .menu-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .uh-header .menu-burger.open span:nth-child(2){opacity:0}
    .uh-header .menu-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
    .uh-mobile-nav{display:none;flex-direction:column;background:#fff;border-top:1px solid #e6ecf4;box-shadow:0 14px 30px rgba(15,27,42,.08)}
    .uh-mobile-nav.open{display:flex}
    .uh-mobile-nav a{text-decoration:none;color:#0a1726;font-size:14px;font-weight:800;padding:15px 18px;border-bottom:1px solid #eef2f7}
    .uh-mobile-nav a:last-child{border-bottom:0}
    @media(min-width:1001px){.uh-mobile-nav{display:none!important}}
    @media(max-width:1000px){.uh-header nav.uh-nav{display:none}.uh-header .menu-burger{display:flex}}
    @media(max-width:600px){.uh-header .header-container{height:76px}.uh-header .logo>a:first-child img{height:60px!important;max-width:125px!important}.uh-header .insta{margin-left:6px;padding:6px 9px;gap:5px}.uh-header .insta span{font-size:9px}.uh-header .lang button{padding:6px 9px;font-size:11px}.uh-header .wa-head{font-size:0}}
    @media(max-width:420px){.uh-header .insta span{display:none}}
  </style>
  <GoogleAdsTag />
</head>
<body>
<header class="site-header uh-header">
  <div class="header-container">
    <div class="logo"><a href={homeUrl} aria-label="Tatildokya Travels"><img src="/images/logo/tatildokya-travels.webp" alt="Tatildokya Travels" width="150" height="70" loading="lazy" decoding="async"/></a><a class="insta" href="https://www.instagram.com/tatildokyatravel/" target="_blank" rel="noopener"><img src="/images/icons/instagram-logo.webp" alt="" width="24" height="24" loading="lazy"/><span>@tatildokyatravel</span></a></div>
    <nav class="uh-nav" aria-label="Main navigation">
      <a href={balloonUrl}>{labels.balloon}</a>
      <a href={toursUrl}>{labels.tours}</a>
      <a href={activitiesUrl}>{labels.activities}</a>
      <a href={privateUrl}>{labels.private}</a>
      <a href={transfersUrl}>{labels.transfers}</a>
      <a href={flightUrl}>{labels.flight}</a>
      <a href={blogUrl}>{labels.blog}</a>
    </nav>
    <div class="head-right"><div class="lang"><button type="button" id="langBtn">{lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧'} {lang.toUpperCase()} ▾</button><div><a href="/en/blog/">🇬🇧 English</a><a href="/tr/blog/">🇹🇷 Türkçe</a><a href="/es/blog/">🇪🇸 Español</a></div></div><a class="wa-head" href="https://wa.me/905333925450" target="_blank" rel="noopener"><img src="/images/icons/whatsapp-logo.webp" alt="" width="24" height="24" loading="lazy"/>WhatsApp</a><button type="button" class="menu-burger" aria-label="Toggle menu" aria-expanded="false"><span></span><span></span><span></span></button></div>
  </div>
  <nav class="uh-mobile-nav">
    <a href={balloonUrl}>{labels.balloon}</a>
    <a href={toursUrl}>{labels.tours}</a>
    <a href={activitiesUrl}>{labels.activities}</a>
    <a href={privateUrl}>{labels.private}</a>
    <a href={transfersUrl}>{labels.transfers}</a>
    <a href={flightUrl}>{labels.flight}</a>
    <a href={blogUrl}>{labels.blog}</a>
  </nav>
</header>
<div class="crumb"><a href={homeUrl}>Tatildokya Travels</a> › <a href={blogUrl}>{labels.blog}</a> › {article.title}</div>
<section class="hero">
  <span class="kicker">{labels.migrated}</span>
  <h1>{article.title}</h1>
  <p>{article.description}</p>
  <div class="meta">
    {article.focusKeyword && <span>Focus: {article.focusKeyword}</span>}
    <span>{labels.updated}: 2026</span>
  </div>
</section>
<div class="hero-image"><img src={heroImage} alt={`${article.title} - Cappadocia travel guide`} width="1180" height="480" decoding="async" fetchpriority="high"/></div>
<main class="layout">
  <article class="article" set:html={article.contentHtml}></article>
  <aside class="sidebar">
    <section class="side-card">
      <h2>{labels.related}</h2>
      <p>{lang==="tr" ? "Rehberden sonra güncel ürün ve planlama sayfalarına geçebilirsiniz." : "Continue from the guide to current booking and planning pages."}</p>
      <div class="side-links">
        <a href={balloonUrl}>{labels.balloon} →</a>
        <a href={toursUrl}>{labels.tours} →</a>
        <a href={flightUrl}>{labels.flight} →</a>
        <a href={blogUrl}>{labels.back} →</a>
      </div>
    </section>
    <section class="side-card cta">
      <h2>{labels.cta}</h2>
      <p>{labels.ctaText}</p>
      <a href="https://wa.me/905333925450" target="_blank" rel="noopener">{labels.whatsapp}</a>
    </section>
  </aside>
</main>
<footer class="footer">© 2026 Tatildokya Travels · Cappadocia, Türkiye</footer>
<a class="assistant" href="https://wa.me/905333925450" target="_blank" rel="noopener"><img src="/images/icons/whatsapp-logo.webp" alt="" width="600" height="600" loading="lazy"/> Assistant</a>
<script is:inline>
  document.querySelectorAll('.uh-header .lang').forEach((wrap) => {
    const btn = wrap.querySelector('button');
    const menu = wrap.querySelector('div:last-child');
    btn?.addEventListener('click', (e) => { e.stopPropagation(); wrap.classList.toggle('open'); });
    document.addEventListener('click', () => wrap.classList.remove('open'));
  });
  const lsBurger=document.querySelector('.uh-header .menu-burger'),lsNav=document.querySelector('.uh-mobile-nav');
  lsBurger?.addEventListener('click',()=>{const isOpen=lsNav?.classList.toggle('open');lsBurger.classList.toggle('open',!!isOpen);lsBurger.setAttribute('aria-expanded',isOpen?'true':'false')});
  lsNav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{lsNav.classList.remove('open');lsBurger?.classList.remove('open');lsBurger?.setAttribute('aria-expanded','false')}));
</script>
</body>
</html>
