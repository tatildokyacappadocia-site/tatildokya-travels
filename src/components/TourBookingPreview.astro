---
// Referans tasarıma (rakip sitenin "Select Date / Guests / Booking Summary" akışı)
// birebir uyan, 3 ayrı karttan oluşan rezervasyon önizleme widget'ı.
// ÖNEMLİ DÜRÜSTLÜK NOTU: Gerçek bir müsaitlik/stok veri kaynağımız henüz yok.
// Bu yüzden takvimdeki her tarih varsayılan olarak "Available" (yeşil) gösterilir —
// rastgele "Sold Out" / "Alternatives" durumu UYDURULMAZ. İleride Supabase'de
// tarih bazlı kapasite verisi oluşturulursa, aşağıdaki window.__TBC_DATE_STATUS__
// objesine {'2026-08-26':'sold', '2026-08-27':'alternative', ...} şeklinde veri
// beslenerek noktalar gerçek verilerle boyanır; kod buna hazır, sadece veri bekliyor.
// Kapora/bakiye (deposit/balance) YOK — ödeme altyapısı yok; buton doğrudan
// rezervasyon formuna (4 adımlı sihirbazın Booking Form adımına) yönlendirir.
const { lang = "en", tourName = "", tourSlug = "" } = Astro.props;

const copy = {
  en: {
    selectDate: "Select Date",
    guests: "Guests",
    adults: "Adults",
    children: "Children",
    available: "Available",
    alternatives: "Alternatives",
    soldOut: "Sold Out",
    selected: "Selected",
    ticketPrice: "Ticket Price",
    bookingSummary: "Booking Summary",
    flightPackage: "Flight Package",
    date: "Date",
    total: "Total",
    adultsWord: "adults",
    adultWord: "adult",
    proceed: "Fill Reservation Form",
    soldOutBtn: "Sold Out",
    pickDateFirst: "Please select a date first.",
  },
  tr: {
    selectDate: "Tarih Seçin",
    guests: "Kişi Sayısı",
    adults: "Yetişkin",
    children: "Çocuk",
    available: "Müsait",
    alternatives: "Alternatif",
    soldOut: "Dolu",
    selected: "Seçili",
    ticketPrice: "Bilet Fiyatı",
    bookingSummary: "Rezervasyon Özeti",
    flightPackage: "Uçuş Paketi",
    date: "Tarih",
    total: "Toplam",
    adultsWord: "yetişkin",
    adultWord: "yetişkin",
    proceed: "Rezervasyon Formunu Doldur",
    soldOutBtn: "Dolu",
    pickDateFirst: "Lütfen önce bir tarih seçin.",
  },
  es: {
    selectDate: "Elegir Fecha",
    guests: "Viajeros",
    adults: "Adultos",
    children: "Niños",
    available: "Disponible",
    alternatives: "Alternativas",
    soldOut: "Agotado",
    selected: "Seleccionado",
    ticketPrice: "Precio del Ticket",
    bookingSummary: "Resumen de Reserva",
    flightPackage: "Paquete de Vuelo",
    date: "Fecha",
    total: "Total",
    adultsWord: "adultos",
    adultWord: "adulto",
    proceed: "Rellenar Formulario",
    soldOutBtn: "Agotado",
    pickDateFirst: "Por favor selecciona una fecha primero.",
  },
};
const c = copy[lang] || copy.en;
const widgetId = `tbp-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="tbp-wrap" id={widgetId} data-lang={lang} data-tour={tourName} data-slug={tourSlug}>

  <!-- CARD 1: SELECT DATE -->
  <div class="tbp-card">
    <h3 class="tbp-card-title">{c.selectDate}</h3>
    <div class="tbp-cal-head">
      <button type="button" class="tbp-cal-arrow" data-tbp-prev aria-label="Previous month">‹</button>
      <span class="tbp-cal-month"><span aria-hidden="true">📅</span> <span data-tbp-cal-title></span></span>
      <button type="button" class="tbp-cal-arrow" data-tbp-next aria-label="Next month">›</button>
    </div>
    <div class="tbp-cal-weekdays">
      <span>SU</span><span>MO</span><span>TU</span><span>WE</span><span>TH</span><span>FR</span><span>SA</span>
    </div>
    <div class="tbp-cal-days" data-tbp-cal-days></div>

    <div class="tbp-legend">
      <span><i class="tbp-dot tbp-dot-green"></i>{c.available}</span>
      <span><i class="tbp-dot tbp-dot-amber"></i>{c.alternatives}</span>
      <span><i class="tbp-dot tbp-dot-red"></i>{c.soldOut}</span>
    </div>

    <div class="tbp-selected-box" data-tbp-selected-box hidden>
      <div class="tbp-selected-row">
        <span data-tbp-selected-icon>📅</span>
        <span class="tbp-selected-label" data-tbp-selected-label>{c.selected}</span>
        <strong data-tbp-selected-date></strong>
      </div>
      <div class="tbp-selected-row">
        <span data-tbp-price-icon>🟢</span>
        <span class="tbp-selected-label" data-tbp-price-label>{c.ticketPrice}</span>
        <strong data-tbp-price-value></strong>
      </div>
    </div>
  </div>

  <!-- CARD 2: GUESTS -->
  <div class="tbp-card">
    <h3 class="tbp-card-title">{c.guests}</h3>
    <div class="tbp-stepper-row">
      <span>{c.adults}</span>
      <div class="tbp-stepper">
        <button type="button" data-tbp-adults-minus aria-label="minus">−</button>
        <span data-tbp-adults>1</span>
        <button type="button" data-tbp-adults-plus aria-label="plus">+</button>
      </div>
    </div>
    <div class="tbp-stepper-row">
      <span>{c.children}</span>
      <div class="tbp-stepper">
        <button type="button" data-tbp-children-minus aria-label="minus">−</button>
        <span data-tbp-children>0</span>
        <button type="button" data-tbp-children-plus aria-label="plus">+</button>
      </div>
    </div>
  </div>

  <!-- CARD 3: BOOKING SUMMARY -->
  <div class="tbp-card">
    <h3 class="tbp-card-title tbp-summary-title">{c.bookingSummary}</h3>
    <div class="tbp-summary-row"><span>{c.flightPackage}</span><strong data-tbp-sum-tour>{tourName}</strong></div>
    <div class="tbp-summary-row"><span>{c.date}</span><strong data-tbp-sum-date>—</strong></div>
    <div class="tbp-summary-row"><span>{c.guests}</span><strong data-tbp-sum-guests>1 {c.adultsWord}</strong></div>
    <div class="tbp-summary-divider"></div>
    <div class="tbp-summary-row tbp-summary-line"><span data-tbp-sum-calc>—</span><strong data-tbp-sum-line-total>—</strong></div>
    <div class="tbp-summary-row tbp-summary-total"><span>{c.total}</span><strong data-tbp-total>—</strong></div>

    <button type="button" class="tbp-proceed-btn" data-tbp-proceed>{c.proceed}</button>
  </div>
</div>

<script define:vars={{ widgetId, lang, pickDateFirst: c.pickDateFirst, adultsWord: c.adultsWord, adultWord: c.adultWord, soldOutBtn: c.soldOutBtn, proceedLabel: c.proceed, soldOutText: c.soldOut, selectedLabelText: c.selected, ticketPriceText: c.ticketPrice }}>
  (() => {
    const root = document.getElementById(widgetId);
    if (!root) return;

    const tourName = root.dataset.tour || '';
    const tourSlug = root.dataset.slug || '';

    // Ger\u00e7ek tarih baz\u0131nda m\u00fcsaitlik verisi olu\u015fturulunca burada okunur.
    // Veri yoksa (varsay\u0131lan) her tarih 'available' kabul edilir \u2014 uydurma yok.
    const dateStatus = window.__TBC_DATE_STATUS__ || {};

    const calTitle = root.querySelector('[data-tbp-cal-title]');
    const calDays = root.querySelector('[data-tbp-cal-days]');
    const prevBtn = root.querySelector('[data-tbp-prev]');
    const nextBtn = root.querySelector('[data-tbp-next]');
    const selectedBox = root.querySelector('[data-tbp-selected-box]');
    const selectedIcon = root.querySelector('[data-tbp-selected-icon]');
    const selectedLabel = root.querySelector('[data-tbp-selected-label]');
    const selectedDateEl = root.querySelector('[data-tbp-selected-date]');
    const priceIcon = root.querySelector('[data-tbp-price-icon]');
    const priceLabel = root.querySelector('[data-tbp-price-label]');
    const priceValue = root.querySelector('[data-tbp-price-value]');

    const adultsEl = root.querySelector('[data-tbp-adults]');
    const childrenEl = root.querySelector('[data-tbp-children]');

    const sumTour = root.querySelector('[data-tbp-sum-tour]');
    const sumDate = root.querySelector('[data-tbp-sum-date]');
    const sumGuests = root.querySelector('[data-tbp-sum-guests]');
    const sumCalc = root.querySelector('[data-tbp-sum-calc]');
    const sumLineTotal = root.querySelector('[data-tbp-sum-line-total]');
    const totalEl = root.querySelector('[data-tbp-total]');
    const proceedBtn = root.querySelector('[data-tbp-proceed]');

    let selectedDate = null;
    let selectedStatus = 'available';
    let viewYear, viewMonth;
    const today = new Date();
    viewYear = today.getFullYear();
    viewMonth = today.getMonth();
    let adults = 1;
    let children = 0;

    const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const weekdayShort = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    function pad(n) { return String(n).padStart(2, '0'); }
    function isoKey(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }

    function getUnitPrice() {
      const priceEl = document.getElementById('tbc-main-price') || document.getElementById('mainPrice');
      if (!priceEl) return null;
      const match = priceEl.textContent.match(/[\d.,]+/);
      if (!match) return null;
      const num = parseFloat(match[0].replace(',', '.'));
      return isNaN(num) ? null : num;
    }

    function renderCalendar() {
      calTitle.textContent = `${monthNames[viewMonth]} ${viewYear}`;
      calDays.innerHTML = '';
      const firstDay = new Date(viewYear, viewMonth, 1);
      const startOffset = firstDay.getDay(); // Sunday-first (SU MO TU...)
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      const todayMidnight = new Date(today.getFullYear(), today.getMonth(), today.getDate());

      for (let i = 0; i < startOffset; i++) {
        const blank = document.createElement('span');
        blank.className = 'tbp-day tbp-day-blank';
        calDays.appendChild(blank);
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const thisDate = new Date(viewYear, viewMonth, d);
        const key = isoKey(viewYear, viewMonth, d);
        const status = dateStatus[key] || 'available';

        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'tbp-day';
        cell.innerHTML = `<span>${d}</span><i class="tbp-day-dot tbp-dot-${status === 'sold' ? 'red' : status === 'alternative' ? 'amber' : 'green'}"></i>`;

        if (thisDate < todayMidnight) {
          cell.disabled = true;
          cell.classList.add('is-past');
        } else {
          cell.addEventListener('click', () => {
            selectedDate = { y: viewYear, m: viewMonth, d };
            selectedStatus = status;
            calDays.querySelectorAll('.tbp-day.is-selected').forEach((el) => el.classList.remove('is-selected'));
            cell.classList.add('is-selected');
            updateSelectedBox();
            updateSummary();
          });
          if (selectedDate && selectedDate.y === viewYear && selectedDate.m === viewMonth && selectedDate.d === d) {
            cell.classList.add('is-selected');
          }
        }
        calDays.appendChild(cell);
      }
    }

    prevBtn.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });

    function formatLongDate(y, m, d) {
      const dt = new Date(y, m, d);
      const dayName = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][dt.getDay()];
      return `${dayName}, ${monthNames[m]} ${d}, ${y}`;
    }

    function updateSelectedBox() {
      if (!selectedDate) { selectedBox.hidden = true; selectedBox.classList.remove('is-shown'); return; }
      selectedBox.hidden = false;
      selectedBox.classList.add('is-shown');
      const unit = getUnitPrice();
      const isSold = selectedStatus === 'sold';
      selectedBox.classList.toggle('is-sold', isSold);
      selectedDateEl.textContent = formatLongDate(selectedDate.y, selectedDate.m, selectedDate.d);
      selectedIcon.textContent = isSold ? '🔴' : '📅';
      selectedLabel.textContent = isSold ? soldOutText : selectedLabelText;
      priceIcon.textContent = isSold ? '🔴' : '🟢';
      priceLabel.textContent = isSold ? soldOutText : ticketPriceText;
      priceValue.textContent = isSold ? soldOutText : (unit != null ? `€${unit}` : '—');
    }

    function updateSummary() {
      const wordForAdults = adults === 1 ? adultWord : adultsWord;
      const unit = getUnitPrice();
      const isSold = selectedStatus === 'sold';
      sumDate.textContent = selectedDate ? `${pad(selectedDate.d)}.${pad(selectedDate.m + 1)}.${selectedDate.y}` : '—';
      sumGuests.textContent = `${adults} ${wordForAdults}${children ? ' + ' + children : ''}`;

      if (isSold || unit == null || !selectedDate) {
        sumCalc.textContent = isSold ? soldOutText : `— × ${adults} ${wordForAdults}`;
        sumLineTotal.textContent = isSold ? '€0.00' : '—';
        totalEl.textContent = isSold ? '€0.00' : '—';
        proceedBtn.textContent = isSold ? soldOutBtn : proceedLabel;
        proceedBtn.disabled = isSold;
        proceedBtn.classList.toggle('is-disabled', isSold);
        return;
      }

      const total = unit * adults;
      sumCalc.textContent = `€${unit} × ${adults} ${wordForAdults}`;
      sumLineTotal.textContent = `€${total.toFixed(2)}`;
      totalEl.textContent = `€${total.toFixed(2)}`;
      proceedBtn.textContent = proceedLabel;
      proceedBtn.disabled = false;
      proceedBtn.classList.remove('is-disabled');
    }

    root.querySelector('[data-tbp-adults-plus]').addEventListener('click', () => { adults = Math.min(adults + 1, 20); adultsEl.textContent = adults; updateSummary(); });
    root.querySelector('[data-tbp-adults-minus]').addEventListener('click', () => { adults = Math.max(adults - 1, 1); adultsEl.textContent = adults; updateSummary(); });
    root.querySelector('[data-tbp-children-plus]').addEventListener('click', () => { children = Math.min(children + 1, 20); childrenEl.textContent = children; updateSummary(); });
    root.querySelector('[data-tbp-children-minus]').addEventListener('click', () => { children = Math.max(children - 1, 0); childrenEl.textContent = children; updateSummary(); });

    proceedBtn.addEventListener('click', () => {
      if (!selectedDate) {
        alert(pickDateFirst);
        return;
      }
      if (selectedStatus === 'sold') return;
      const dateStr = `${pad(selectedDate.d)}.${pad(selectedDate.m + 1)}.${selectedDate.y}`;
      const params = new URLSearchParams({
        tour: tourName,
        slug: tourSlug,
        date: dateStr,
        people: String(adults + children),
        step: '2',
      });
      window.location.href = `/${lang}/booking/?${params.toString()}`;
    });

    renderCalendar();
    updateSelectedBox();
    updateSummary();
  })();
</script>

<style>
  .tbp-wrap { display: flex; flex-direction: column; gap: 16px; font-family: 'Inter', Arial, sans-serif; }
  .tbp-card { background: #fff; border: 1px solid #e5eef7; border-radius: 18px; padding: 20px; box-shadow: 0 10px 26px rgba(10,24,48,.06); }
  .tbp-card-title { font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; font-size: 17px; font-weight: 800; color: #0a1830; margin: 0 0 14px; }

  .tbp-cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 8px; }
  .tbp-cal-month { font-size: 13px; font-weight: 800; color: #0a1830; display: flex; align-items: center; gap: 6px; }
  .tbp-cal-arrow { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #e5eef7; background: #f7fafd; cursor: pointer; font-size: 15px; color: #0a1830; flex-shrink: 0; }
  .tbp-cal-arrow:hover { background: #1478d4; color: #fff; border-color: #1478d4; }

  .tbp-cal-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin-bottom: 4px; }
  .tbp-cal-weekdays span { text-align: center; font-size: 9px; font-weight: 800; color: #94a3b8; text-transform: uppercase; }
  .tbp-cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin-bottom: 14px; }

  /* Bu takvim g\u00fcnleri JavaScript ile (document.createElement) olu\u015fturuluyor,
     bu y\u00fczden Astro'nun otomatik style scoping'i onlara uygulanm\u0131yor.
     :global() ile bu elementleri kapsam d\u0131\u015f\u0131na (global CSS) al\u0131yoruz ki
     stiller kesinlikle eşleşsin. */
  :global(.tbp-day) { aspect-ratio: 1/1; min-width: 0; border: 1px solid #eef2f7; border-radius: 8px; background: #f7fafd; font-size: 10.5px; font-weight: 700; color: #0a1830; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; padding: 2px; }
  :global(.tbp-day-blank) { visibility: hidden; }
  :global(.tbp-day:hover:not(:disabled)) { border-color: #1478d4; }
  :global(.tbp-day.is-selected) { background: #0a1830; color: #fff; border-color: #0a1830; }
  :global(.tbp-day.is-past) { background: #f4f6f8; color: #cbd5e1; cursor: not-allowed; }
  :global(.tbp-day.is-past .tbp-day-dot) { display: none; }
  :global(.tbp-day-dot) { display: inline-block; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  :global(.tbp-day-dot.tbp-dot-green) { background: #16a34a; }
  :global(.tbp-day-dot.tbp-dot-amber) { background: #eab308; }
  :global(.tbp-day-dot.tbp-dot-red) { background: #dc2626; }

  .tbp-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 4px; }
  .tbp-dot-green { background: #16a34a; }
  .tbp-dot-amber { background: #eab308; }
  .tbp-dot-red { background: #dc2626; }

  .tbp-legend { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
  .tbp-legend span { display: flex; align-items: center; font-size: 10.5px; font-weight: 700; color: #5c7797; }

  .tbp-selected-box { display: none; background: #eafaf0; border: 1px solid #bfe8cf; border-radius: 12px; padding: 12px 14px; flex-direction: column; gap: 8px; }
  .tbp-selected-box.is-shown { display: flex; }
  .tbp-selected-box.is-sold { background: #fdeceb; border-color: #f6c9c5; }
  .tbp-selected-row { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .tbp-selected-label { color: #3a6b4d; font-weight: 700; flex: 1; }
  .tbp-selected-box.is-sold .tbp-selected-label { color: #b3261e; }
  .tbp-selected-row strong { color: #0a1830; font-weight: 900; font-size: 13px; }
  .tbp-selected-box.is-sold .tbp-selected-row strong { color: #b3261e; }

  .tbp-stepper-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; font-size: 13px; font-weight: 700; color: #0a1830; }
  .tbp-stepper { display: flex; align-items: center; gap: 10px; }
  .tbp-stepper button { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #d5e2ef; background: #f7fafd; font-size: 15px; font-weight: 800; color: #0a1830; cursor: pointer; }
  .tbp-stepper button:hover { background: #1478d4; color: #fff; border-color: #1478d4; }
  .tbp-stepper span { min-width: 16px; text-align: center; font-size: 13px; }

  .tbp-summary-title { color: #0d5aa0; }
  .tbp-summary-row { display: flex; align-items: center; justify-content: space-between; padding: 5px 0; font-size: 12.5px; }
  .tbp-summary-row > span:first-child { color: #5c7797; }
  .tbp-summary-row strong { color: #0a1830; font-weight: 800; }
  .tbp-summary-divider { height: 1px; background: #eef2f7; margin: 8px 0; }
  .tbp-summary-line { font-size: 12px; color: #5c7797; }
  .tbp-summary-total { padding-top: 10px; }
  .tbp-summary-total span { font-size: 14px; font-weight: 900; color: #0a1830; }
  .tbp-summary-total strong { font-size: 18px; color: #1478d4; }

  .tbp-proceed-btn { width: 100%; min-height: 50px; margin-top: 16px; border: 0; border-radius: 999px; background: linear-gradient(135deg, #2f8ee0, #0d3f80); color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; box-shadow: 0 10px 24px rgba(13,63,128,.3); transition: transform .15s ease; }
  .tbp-proceed-btn:hover:not(:disabled) { transform: translateY(-2px); }
  .tbp-proceed-btn.is-disabled, .tbp-proceed-btn:disabled { background: #9aa7b8; box-shadow: none; cursor: not-allowed; }
</style>
