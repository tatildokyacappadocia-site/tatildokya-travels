---
import { SITE_URL, resolveSeo, canonicalUrl, alternateUrls, normalizePath } from '../data/seoMigrated';
import { seoAdminOverrides } from '../data/seoAdmin.generated';
import { siteRating } from '../data/siteRating.generated';
import GoogleAdsTag from './GoogleAdsTag.astro';

const {
  title = 'Tatildokya Travels',
  description = '',
  lang = 'en',
  image = '/images/logo/tatildokya-travels.webp',
  type = 'website',
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const baseSeo = resolveSeo(path, title, description);
const override = seoAdminOverrides[normalizePath(path)] || {};

const seo = {
  title: override.title || baseSeo.title,
  description: override.description || baseSeo.description,
  focusKeyword: override.focusKeyword || baseSeo.focusKeyword,
};

const canonical = override.canonicalUrl || canonicalUrl(path);
const alternates = alternateUrls(path);
const finalNoindex = noindex || override.index === false;
const schemaType = override.schemaType || 'WebPage';

const socialTitle = override.ogTitle || seo.title;
const socialDescription = override.ogDescription || seo.description;
const socialImage = override.ogImage || image;

const imageUrl = socialImage?.startsWith('http')
  ? socialImage
  : `${SITE_URL}${socialImage || '/images/logo/tatildokya-travels.webp'}`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: seo.title,
  description: seo.description || undefined,
  url: canonical,
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Tatildokya Travels',
    url: SITE_URL
  }
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Tatildokya Travels',
  url: SITE_URL,
  logo: `${SITE_URL}/images/logo/tatildokya-travels.webp`,
  image: `${SITE_URL}/images/logo/tatildokya-travels.webp`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cumhuriyet, Saraçoğlu Sk. No:11 D:2',
    addressLocality: 'Ürgüp/Nevşehir',
    postalCode: '50400',
    addressCountry: 'TR'
  },
  areaServed: {
    '@type': 'Place',
    name: 'Cappadocia, Turkey'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+90-533-392-54-50',
    contactType: 'customer service'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: siteRating.ratingValue,
    reviewCount: siteRating.reviewCount,
    bestRating: '5',
    worstRating: '1'
  },
  sameAs: [
    'https://www.instagram.com/tatildokyatravel/',
    'https://www.tripadvisor.com/Attraction_Review-g297983-d19185861-Reviews-Tatildokya_Travel_Turkey-Goreme_Nevsehir_Province_Cappadocia.html'
  ]
};
---

<title>{seo.title}</title>

{seo.description && <meta name="description" content={seo.description} />}

<meta
  name="robots"
  content={finalNoindex
    ? 'noindex,nofollow'
    : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
/>

<link rel="canonical" href={canonical} />

{alternates.map((a) => (
  <link rel="alternate" hreflang={a.lang} href={a.href} />
))}

{alternates.length > 0 && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={alternates.find((a) => a.lang === 'en')?.href}
  />
)}

<!-- Tatildokya Travels favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=11" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=11" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=11" />
<link rel="shortcut icon" href="/favicon.ico?v=11" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=11" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Tatildokya Travels" />
<meta property="og:title" content={socialTitle} />

{socialDescription && (
  <meta property="og:description" content={socialDescription} />
)}

<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />

{socialDescription && (
  <meta name="twitter:description" content={socialDescription} />
)}

<meta name="twitter:image" content={imageUrl} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(pageSchema)}
></script>

<script
  type="application/ld+json"
  set:html={JSON.stringify(orgSchema)}
></script>

<GoogleAdsTag />