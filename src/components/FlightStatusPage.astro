---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoHead title={seo.metaTitle} description={seo.metaDescription} lang={lang} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'"><noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet"></noscript>
</head>
<body>
<SiteHeader lang={lang} active="flight" />
<section class="flight-category-hero" id="flight-status-top">
  <div class="flight-hero-inner">
    <span class="flight-hero-badge">TATILDOKYA TRAVELS</span>
    <h1>{t.pageTitle}</h1>
    <p>{t.pageSubtitle}</p>
  </div>
</section>

<main class="tbc-page">
  <div class="breadcrumbs"><a href={`/${lang}/`}>{t.home}</a><span>›</span><strong>{t.flightStatus}</strong></div>

  <section class="status-shell">
    <div class="feed-header">
      <div>
        <span class="official-badge">{t.officialBadge}</span>
        <h2 class="status-panel-title"> {t.officialBadge}</h2>
        <p>{t.pageSubtitle}</p>
      </div>
      <div class="sync-badge">🕒 {t.lastOfficialUpdate}: <strong id="last-sync-time">—</strong></div>
    </div>

    <div class="clock-bar">
      <span class="clock-local">⏰ {t.localTime}: <strong id="live-local-time">--:--:--</strong> (UTC+3)</span>
      <span class="clock-zulu">🌐 {t.zuluTime}: <strong id="live-zulu-time">--:--:--</strong> Z</span>
      <button id="refreshBtn" type="button">↻ {t.refresh}</button>
    </div>

    <div id="load-message" class="load-message">{t.loading}</div>

    <section class="morning-dashboard morning-dashboard-top" aria-label="Göreme morning flight planning">
      <article class="sunrise-card sunrise-card-compact sunrise-premium sunrise-today">
        <div class="sunrise-art" aria-hidden="true">
          <span class="sun-disc"></span>
          <span class="premium-balloon premium-balloon-one" aria-hidden="true">
