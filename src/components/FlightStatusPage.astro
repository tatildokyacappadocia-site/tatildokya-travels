          </span>
          <span class="premium-balloon premium-balloon-two" aria-hidden="true">
            <svg viewBox="0 0 64 88"><path d="M32 3C15 3 5 15 7 31c2 15 13 26 20 33h10c7-7 18-18 20-33C59 15 49 3 32 3Z" fill="#ef6a2f" stroke="#cbe1fb" stroke-width="2"/><path d="M21 9c-4 15-2 31 7 54M43 9c4 15 2 31-7 54M32 5v58" fill="none" stroke="#aacdf8" stroke-width="2"/><path d="M27 64h10l-2 8h-6Z" fill="#285080"/><path d="M25 73h14l-2 10H27Z" fill="#2d5e9b"/></svg>
          </span>
          <span class="horizon-line"></span>
        </div>
        <div class="sunrise-content">
          <span id="banner-title-1" class="sunrise-label">↑ {t.today} • {t.sunrise}</span>
          <div class="sunrise-time-row">
            <span class="sunrise-mini-icon">☀</span>
            <strong id="sunrise-time-today" class="sunrise-time">--:--</strong>
          </div>
          <div class="flight-window">
            <b>{t.flightSchedule}</b>
            <small class="flight-window-note">{t.flightScheduleNote}</small>
            <span> {t.firstSlot}: <strong id="win-start-today">--:--</strong></span>
            <span> {t.secondSlot}: <strong id="win-end-today">--:--</strong></span>
          </div>
        </div>
      </article>

      <article class="sunrise-card sunrise-card-compact sunrise-premium sunrise-tomorrow">
        <div class="sunrise-art" aria-hidden="true">
          <span class="sun-disc"></span>
          <span class="premium-balloon premium-balloon-one" aria-hidden="true">
            <svg viewBox="0 0 64 88" role="img"><defs><linearGradient id="habg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e7462e"/><stop offset=".35" stop-color="#1371e4"/><stop offset=".68" stop-color="#1d508f"/><stop offset="1" stop-color="#17529b"/></linearGradient></defs><path d="M32 3C15 3 5 15 7 31c2 15 13 26 20 33h10c7-7 18-18 20-33C59 15 49 3 32 3Z" fill="url(#habg1)" stroke="#cbe1fb" stroke-width="2"/><path d="M20 9c-5 14-3 31 8 54M44 9c5 14 3 31-8 54M32 5v58" fill="none" stroke="#d3e5fb" stroke-width="2" opacity=".8"/><path d="M27 64h10l-2 8h-6Z" fill="#285080"/><path d="M25 73h14l-2 10H27Z" fill="#2d5e9b" stroke="#1f426d"/></svg>
          </span>
          <span class="premium-balloon premium-balloon-two" aria-hidden="true">
            <svg viewBox="0 0 64 88"><path d="M32 3C15 3 5 15 7 31c2 15 13 26 20 33h10c7-7 18-18 20-33C59 15 49 3 32 3Z" fill="#ef6a2f" stroke="#cbe1fb" stroke-width="2"/><path d="M21 9c-4 15-2 31 7 54M43 9c4 15 2 31-7 54M32 5v58" fill="none" stroke="#aacdf8" stroke-width="2"/><path d="M27 64h10l-2 8h-6Z" fill="#285080"/><path d="M25 73h14l-2 10H27Z" fill="#2d5e9b"/></svg>
          </span>
          <span class="horizon-line"></span>
        </div>
        <div class="sunrise-content">
          <span id="banner-title-2" class="sunrise-label">↑ {t.tomorrow} • {t.sunrise}</span>
          <div class="sunrise-time-row">
            <span class="sunrise-mini-icon">☀</span>
            <strong id="sunrise-time-tom" class="sunrise-time">--:--</strong>
          </div>
          <div class="flight-window">
            <b>{t.flightSchedule}</b>
            <small class="flight-window-note">{t.flightScheduleNote}</small>
            <span> {t.firstSlot}: <strong id="win-start-tom">--:--</strong></span>
            <span> {t.secondSlot}: <strong id="win-end-tom">--:--</strong></span>
          </div>
        </div>
      </article>

      <article class="weather-card weather-compact weather-right">
        <div class="weather-head">
          <div class="weather-title">
            <span id="weather-icon" class="weather-icon">🌤️</span>
            <div>
              <span class="weather-eyebrow">GÖREME • LIVE METEOROLOGY</span>
              <h2>{t.weather}</h2>
              <small>{t.weatherSub}</small>
            </div>
          </div>
          <div class="weather-live-dot"><span></span> LIVE</div>
        </div>

        <div class="weather-grid weather-grid-compact">
          <div><span>{t.temperature}</span><strong id="temperature">—</strong></div>
          <div><span>{t.precipitation}</span><strong id="precipitation">—</strong></div>
          <div><span>{t.humidity}</span><strong id="humidity">—</strong></div>
          <div><span>{t.wind}</span><strong id="windSpeed">—</strong></div>
          <div class="weather-wide"><span>{t.windDirection}</span><strong id="windDirection">—</strong></div>
        </div>

        <p class="weather-note">{t.weatherDisclaimer}</p>
      </article>
    </section>


    <div class="alerts-grid" id="dynamic-alerts-container"></div>



    <section class="live-tracking-panel" aria-labelledby="live-tracking-title">
