/* Official-inspired map geometry: equal, aligned rectangles */
.official-sector-map{
  height:310px!important;
  background:
    linear-gradient(27deg,transparent 49%,rgba(150,168,190,.18) 50%,transparent 51%) 0 0/76px 76px,
    linear-gradient(-18deg,transparent 49%,rgba(169,177,187,.13) 50%,transparent 51%) 15px 10px/92px 92px,
    radial-gradient(circle at 70% 20%,rgba(220,237,228,.72),transparent 36%),
    linear-gradient(145deg,#e2ebf7 0%,#e5ebf3 48%,#edf0f4 100%)!important;
}
.official-sector-map::before{
  width:125%!important;left:-12%!important;top:28%!important;
  height:3px!important;transform:rotate(-12deg)!important;
  background:#acc3df!important;opacity:.72!important
}
.official-sector-map::after{
  width:120%!important;left:-8%!important;top:77%!important;
  height:3px!important;transform:rotate(10deg)!important;
