<script define:vars={{ t, lang, locale }}>
(function () {
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const sectorLocations = { A: t.sectorA, B: t.sectorB, C: t.sectorC };
  let currentData = null;

  const STATUS_HISTORY_KEY = 'tbc-flight-status-history-v2';

  function readStatusHistory() {
    try {
      const value = JSON.parse(localStorage.getItem(STATUS_HISTORY_KEY) || '{}');
      return value && typeof value === 'object' ? value : {};
    } catch {
      return {};
    }
  }

  function getDayHistory(dateKey) {
    const all = readStatusHistory();
    return all[dateKey] || { hadGreen:false, hadYellow:false, lastStatus:'' };
  }

  function rememberDayStatus(dateKey, status, hasOfficialRange) {
    if (!dateKey) return;
    const all = readStatusHistory();
    const item = all[dateKey] || { hadGreen:false, hadYellow:false, lastStatus:'' };

    if (status === 'FLOWN') item.hadGreen = true;
    if ((status === 'PENDING' || status === 'PARTIAL') && hasOfficialRange) item.hadYellow = true;

    item.lastStatus = status;
    item.updatedAt = new Date().toISOString();
    all[dateKey] = item;

    Object.keys(all).sort().reverse().slice(14).forEach(k => delete all[k]);
    try { localStorage.setItem(STATUS_HISTORY_KEY, JSON.stringify(all)); } catch {}
  }

  function pad(n) { return String(n).padStart(2, '0'); }
  function parseOfficialUpdate(value) {
    const m=String(value||'').match(/(\d{1,2})[.\-/](\d{1,2})[.\-/](\d{4}).*?(\d{1,2}):(\d{2})/);
    if(!m)return null;
    return { day:+m[1], month:+m[2], year:+m[3], hour:+m[4], minute:+m[5] };
  }
  function officialUpdateTurkeyParts(value) {
    const p=parseOfficialUpdate(value);
    if(!p)return null;
    // Official source timestamp is UTC/Zulu. Convert to Turkey local time (UTC+3).
    const d=new Date(Date.UTC(p.year,p.month-1,p.day,p.hour,p.minute));
    d.setUTCHours(d.getUTCHours()+3);
    return {
      day:d.getUTCDate(), month:d.getUTCMonth()+1, year:d.getUTCFullYear(),
      hour:d.getUTCHours(), minute:d.getUTCMinutes()
    };
  }
  function formatOfficialUpdateTR(value) {
    const p=officialUpdateTurkeyParts(value);
    if(!p)return value||'';
    return `${pad(p.day)}.${pad(p.month)}.${p.year} - ${lang === 'en' ? formatHM(p.hour,p.minute) : `${pad(p.hour)}:${pad(p.minute)}`}`;
  }
  function isPostMorningOfficialUpdate(value) {
    const p=officialUpdateTurkeyParts(value);
    if(!p)return false;
    return p.hour>=8;
  }
  function turkeyNowParts() {
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Istanbul', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false }).formatToParts(new Date());
    return Object.fromEntries(parts.map(p => [p.type, p.value]));
  }
  function updateClocks() {
    const p = turkeyNowParts();
    const local = document.getElementById('live-local-time');
    const zulu = document.getElementById('live-zulu-time');
    if (local) local.textContent = formatClockHM(Number(p.hour), Number(p.minute), Number(p.second));
    const now = new Date();
    if (zulu) zulu.textContent = formatClockHM(now.getUTCHours(), now.getUTCMinutes(), now.getUTCSeconds());
  }
  setInterval(updateClocks, 1000); updateClocks();

  function getTurkeyDate(offsetDays = 0) {
    const p = turkeyNowParts();
    const d = new Date(Number(p.year), Number(p.month) - 1, Number(p.day));
    d.setDate(d.getDate() + offsetDays);
    return d;
  }
  function isoDate(d) { return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }
  function displayDate(d) { return new Intl.DateTimeFormat(locale, { day:'numeric', month:'long', year:'numeric' }).format(d); }
  function validDateFromRange(range) {
    const m = String(range || '').match(/(\d{2})\.(\d{2})\.(\d{4})/);
    return m ? `${m[3]}-${m[2]}-${m[1]}` : '';
  }
  function parseOfficialTime(range) {
    const m = String(range || '').match(/\d{2}\.\d{2}\.\d{4}\s*-\s*(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})/);
    return m ? { start:m[1], end:m[2] } : null;
  }
  function addThreeHours(hm) {
    if (!hm) return '--:--';
    const [h,m] = hm.split(':').map(Number);
    return `${pad((h+3)%24)}:${pad(m)}`;
  }

  function formatOfficialRangeTR(range) {
    const m = String(range || '').match(/(\d{2})\.(\d{2})\.(\d{4})\s*-\s*(\d{2}):(\d{2})\s*-\s*(\d{2}):(\d{2})/);
    if (!m) return range || '';
    const [,dd,mm,yyyy,sh,sm,eh,em] = m;
    const start = new Date(Date.UTC(Number(yyyy), Number(mm)-1, Number(dd), Number(sh), Number(sm)));
    const end = new Date(Date.UTC(Number(yyyy), Number(mm)-1, Number(dd), Number(eh), Number(em)));
    start.setUTCHours(start.getUTCHours()+3);
    end.setUTCHours(end.getUTCHours()+3);
    const format = (d) => `${pad(d.getUTCDate())}.${pad(d.getUTCMonth()+1)}.${d.getUTCFullYear()} - ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
    const sameDate = start.getUTCDate()===end.getUTCDate() && start.getUTCMonth()===end.getUTCMonth() && start.getUTCFullYear()===end.getUTCFullYear();
    if (lang === 'en') {
      const dateStart = `${pad(start.getUTCDate())}.${pad(start.getUTCMonth()+1)}.${start.getUTCFullYear()}`;
      const startTime = formatHM(start.getUTCHours(), start.getUTCMinutes());
      const endTime = formatHM(end.getUTCHours(), end.getUTCMinutes());
      const dateEnd = `${pad(end.getUTCDate())}.${pad(end.getUTCMonth()+1)}.${end.getUTCFullYear()}`;
      return sameDate ? `${dateStart} - ${startTime} - ${endTime}` : `${dateStart} - ${startTime} - ${dateEnd} - ${endTime}`;
    }
    return sameDate
      ? `${pad(start.getUTCDate())}.${pad(start.getUTCMonth()+1)}.${start.getUTCFullYear()} - ${pad(start.getUTCHours())}:${pad(start.getUTCMinutes())} - ${pad(end.getUTCHours())}:${pad(end.getUTCMinutes())}`
      : `${format(start)} - ${format(end)}`;
  }

  function minutesFromHM(hm) {
    if (!hm) return null;
    const [h,m] = hm.split(':').map(Number);
    if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
    return (h * 60) + m;
  }
  function officialDelayMinutes(_updateValue, range) {
    const times = parseOfficialTime(range);
    if (!times) return 0;

    const start = minutesFromHM(times.start);
    const end = minutesFromHM(times.end);
    if (start === null || end === null) return 0;

    let diff = end - start;
    if (diff < 0) diff += 24 * 60;

    return diff > 0 && diff <= 180 ? diff : 0;
  }
  function effectiveStatus(status, update, range) {
    const delay = officialDelayMinutes(update, range);
    if (status === 'PENDING' && range && delay > 0) return 'DELAYED';
    return status;
  }

  function getSunriseTime(date) {
    const lat=38.643, lon=34.829, zen=90.833;
    const dayOfYear=Math.floor((date-new Date(date.getFullYear(),0,0))/(1000*60*60*24));
    const lngHour=lon/15;
    const tt=dayOfYear+((6-lngHour)/24);
    const M=(0.9856*tt)-3.289;
    const L=(M+(1.916*Math.sin(M*Math.PI/180))+(0.020*Math.sin(2*M*Math.PI/180))+282.634+360)%360;
    let RA=(Math.atan(0.91764*Math.tan(L*Math.PI/180))*180/Math.PI+360)%360;
    RA=(RA+((Math.floor(L/90))*90-(Math.floor(RA/90))*90))/15;
    const sinDec=0.39782*Math.sin(L*Math.PI/180);
    const cosDec=Math.cos(Math.asin(sinDec));
    const cosH=(Math.cos(zen*Math.PI/180)-(sinDec*Math.sin(lat*Math.PI/180)))/(cosDec*Math.cos(lat*Math.PI/180));
    const H=(360-(Math.acos(cosH)*180/Math.PI))/15;
    const UT=(H+RA-(0.06571*tt)-6.622-lngHour+24)%24;
    const local=UT+3;
    let hours=Math.floor(local)%24;
    let minutes=Math.round((local-Math.floor(local))*60);
    if(minutes===60){minutes=0;hours=(hours+1)%24;}
    return {hours,minutes};
  }
  function formatHM(h,m){
    if (lang !== 'en') return `${pad(h)}:${pad(m)}`;
    const period = h >= 12 ? 'PM' : 'AM';
    const hour12 = h % 12 || 12;
    return `${hour12}:${pad(m)} ${period}`;
  }
  function formatClockHM(h,m,s=''){
    if (lang !== 'en') return `${pad(h)}:${pad(m)}${s !== '' ? `:${pad(s)}` : ''}`;
    const period = h >= 12 ? 'PM' : 'AM';
    const hour12 = h % 12 || 12;
    return `${hour12}:${pad(m)}${s !== '' ? `:${pad(s)}` : ''} ${period}`;
  }
  function renderSunrise() {
    const today=getTurkeyDate(0), tomorrow=getTurkeyDate(1);
    [[today,'today'],[tomorrow,'tom']].forEach(([d,key])=>{
      const label = document.getElementById(key === 'today' ? 'banner-title-1' : 'banner-title-2');
      if (label) label.textContent = `${key === 'today' ? t.today : t.tomorrow} · ${displayDate(d)} · ${t.sunrise}`;
      const sun=getSunriseTime(d);
      const sunrise=new Date(d); sunrise.setHours(sun.hours,sun.minutes,0,0);
      const start=new Date(sunrise.getTime()-30*60*1000);
      const secondFlight=new Date(sunrise);
      document.getElementById(`sunrise-time-${key}`).textContent=formatHM(sunrise.getHours(),sunrise.getMinutes());
      document.getElementById(`win-start-${key}`).textContent=formatHM(start.getHours(),start.getMinutes());
      document.getElementById(`win-end-${key}`).textContent=formatHM(secondFlight.getHours(),secondFlight.getMinutes());
    });
  }
  renderSunrise();

  function statusLabel(status) {
    if (status === 'DELAYED') return t.delayed;
    if (status === 'COMPLETED') return t.completed;
    if (status === 'CANCELED') return t.canceled;
    if (status === 'FLOWN') return t.suitable;
    if (status === 'PARTIAL') return t.mixed;
    return t.pending;
  }
  function statusClass(status) {
    if (status === 'DELAYED') return 'is-partial';
    if (status === 'COMPLETED') return 'is-suitable';
    if (status === 'CANCELED') return 'is-canceled';
    if (status === 'FLOWN') return 'is-suitable';
    if (status === 'PARTIAL') return 'is-partial';
    return 'is-pending';
  }
  function statusTitle(status, variant = '') {
    if (status === 'DELAYED') return t.delayedTitle;
    if (status === 'COMPLETED') return t.completedTitle;
    if (status === 'CANCELED' && variant === 'launch-site') return t.canceledAtLaunchTitle;
    if (status === 'CANCELED') return t.canceledTitle;
    if (status === 'FLOWN') return t.suitableTitle;
    if (status === 'PARTIAL') return t.partialTitle;
    return t.pendingTitle;
  }
  function statusBody(status, variant = '') {
    if (status === 'DELAYED') return t.delayedBody;
    if (status === 'COMPLETED') return t.completedBody;
    if (status === 'CANCELED' && variant === 'launch-site') return t.canceledAtLaunchBody;
    if (status === 'CANCELED') return t.canceledBody;
    if (status === 'FLOWN') return t.suitableBody;
    if (status === 'PARTIAL') return t.partialBody;
    return t.pendingBody;
  }
  function alertCard(date, status, range, isToday, update, variant = '') {
    const times=parseOfficialTime(range);
    const displayStatus = effectiveStatus(status, update, range);
    const delay = officialDelayMinutes(update, range);
    const tag=isToday?t.today:t.tomorrow;
    const cls=statusClass(displayStatus);
    const icon=displayStatus==='CANCELED'?'✕':displayStatus==='COMPLETED'||displayStatus==='FLOWN'?'✓':displayStatus==='DELAYED'||displayStatus==='PARTIAL'?'!':'⌛';
    return `<article class="alert-card ${cls}">
      <div class="alert-top"><span class="date-tag">${tag} (${displayDate(date)})</span><span class="state-text">● ${displayStatus==='PENDING'?t.decisionPending:`${t.liveStatus}: ${statusLabel(displayStatus)}`}</span></div>
      <div class="alert-title"><span class="alert-icon">${icon}</span><strong>${statusTitle(displayStatus, variant)}</strong></div>
      <p>${statusBody(displayStatus, variant)}</p>
      ${displayStatus==='PENDING' && !isToday && t.pendingUntilNote ? `<p class="pending-until-note">${t.pendingUntilNote}</p>` : ''}
      ${displayStatus==='DELAYED' && delay>0 ? `<div class="delay-callout">⏱ ${t.delayLabel}: <strong>${delay} ${t.minutesShort}</strong></div>` : ''}
      <div class="alert-meta">
        <div><b>${t.validLocal}:</b> ${range?formatOfficialRangeTR(range):t.awaitingInfo}</div>
        ${update?`<div><b>${t.update}:</b> ${formatOfficialUpdateTR(update)}</div>`:''}
      </div>
    </article>`;
  }

  function renderAlerts(data) {
    const today=getTurkeyDate(0), tomorrow=getTurkeyDate(1);
    const validISO=validDateFromRange(data.validDateRange);
    const todayISO=isoDate(today), tomorrowISO=isoDate(tomorrow);
    let todayStatus='PENDING', tomorrowStatus='PENDING';
    let todayRange='', tomorrowRange='';
    let todayUpdate='', tomorrowUpdate='';
    let todayVariant='';

    if(validISO===todayISO){todayStatus=data.status;todayRange=data.validDateRange;todayUpdate=data.lastUpdate;}
    else if(validISO===tomorrowISO){tomorrowStatus=data.status;tomorrowRange=data.validDateRange;tomorrowUpdate=data.lastUpdate;}
    else if(!validISO){todayStatus=data.status;todayRange=data.validDateRange;todayUpdate=data.lastUpdate;}

    const previous = getDayHistory(todayISO);

    // GREEN -> RED and YELLOW -> GREEN -> RED:
    // RED is not a cancellation; the morning operation has already completed.
    if (todayStatus === 'CANCELED' && previous.hadGreen) {
      todayStatus = 'COMPLETED';
    }
    // YELLOW -> RED, with no GREEN:
    // this is a launch-site cancellation, not an early cancellation.
    else if (todayStatus === 'CANCELED' && previous.hadYellow) {
      todayVariant = 'launch-site';
    }
    // Cross-device fallback:
    // localStorage history is device-specific. A phone opened for the first time
    // may not know that GREEN was already observed on desktop earlier that morning.
    // Once the official RED update itself is 08:00 or later in Turkey time,
    // display the post-morning state as COMPLETED on every device.
    else if (todayStatus === 'CANCELED' && isPostMorningOfficialUpdate(todayUpdate)) {
      todayStatus = 'COMPLETED';
    }

    data._todayDisplayStatus = todayStatus;
    data._todayDisplayVariant = todayVariant;

    // Remember the RAW official state only after evaluating the transition.
    const rawTodayStatus = (validISO===todayISO || !validISO) ? data.status : 'PENDING';
    rememberDayStatus(todayISO, rawTodayStatus, Boolean(todayRange));

    const el=document.getElementById('dynamic-alerts-container');
    if(el) el.innerHTML=
      alertCard(today,todayStatus,todayRange,true,todayUpdate,todayVariant)+
      alertCard(tomorrow,tomorrowStatus,tomorrowRange,false,tomorrowUpdate);
  }

  function degToCompass(deg) {
    if (deg === null || deg === undefined || Number.isNaN(Number(deg))) return '—';
    const dirs=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
    return `${Math.round(Number(deg))}° ${dirs[Math.round(Number(deg)/22.5)%16]}`;
  }
  function weatherIcon(code){if([0,1].includes(code))return'☀️';if([2,3].includes(code))return'🌤️';if([45,48].includes(code))return'🌫️';if(code>=51&&code<=67)return'🌧️';if(code>=71&&code<=77)return'🌨️';if(code>=80&&code<=82)return'🌦️';if(code>=95)return'⛈️';return'🌤️';}
  function renderWeather(data) {
    const w=data.weather||{};
    document.getElementById('weather-icon').textContent=weatherIcon(Number(w.weatherCode));
    document.getElementById('temperature').textContent=w.temperature!==undefined?`${Number(w.temperature).toLocaleString(undefined,{maximumFractionDigits:1})}°C`:'—';
    document.getElementById('precipitation').textContent=w.precipitation!==undefined?`${w.precipitation} mm`:'—';
    document.getElementById('humidity').textContent=w.humidity!==undefined?`%${w.humidity}`:'—';
    document.getElementById('windSpeed').textContent=w.windSpeed!==undefined?`${Number(w.windSpeed).toLocaleString(undefined,{maximumFractionDigits:1})} m/s`:'—';
    document.getElementById('windDirection').textContent=degToCompass(w.windDirection);

  }

  function sectorBody(status){
    return status==='CANCELED'?t.sectorCanceled:
      status==='FLOWN'?t.sectorSuitable:
      status==='DELAYED'?t.delayedBody:
      status==='COMPLETED'?t.completedBody:
      t.sectorPending;
  }

  function visualStatus(status) {
    if (status === 'FLOWN') return 'green';
    if (status === 'DELAYED' || status === 'PARTIAL') return 'yellow';
    if (status === 'COMPLETED') return 'completed';
    if (status === 'CANCELED') return 'red';
    return 'pending';
  }

  function updateSectorMap(key, status) {
    const mapSector = document.querySelector(`[data-map-sector="${key}"]`);
    if (!mapSector) return;
    mapSector.classList.remove('map-green','map-yellow','map-red','map-pending');
    const v = visualStatus(status);
    // Completed intentionally becomes RED because no further flights will operate today.
    mapSector.classList.add(
      v === 'green' ? 'map-green' :
      v === 'yellow' ? 'map-yellow' :
      v === 'completed' || v === 'red' ? 'map-red' :
      'map-pending'
    );
  }

  function renderSectors(data) {
    const el=document.getElementById('sector-grid');
    if(!el)return;

    const overallCompleted = data._todayDisplayStatus === 'COMPLETED';

    el.innerHTML=(data.sectors||[]).map(s=>{
      const delay = officialDelayMinutes(s.lastUpdate, s.validDateRange);
      const displayStatus = overallCompleted ? 'COMPLETED' : effectiveStatus(s.status, s.lastUpdate, s.validDateRange);
      const visual = visualStatus(displayStatus);

      // User rule:
      // GREEN = operating -> green flag
      // YELLOW = delayed -> yellow flag
      // RED = canceled -> red flag
      // GREEN -> RED / completed -> RED flag (no further flights today)
      const flagClass =
        visual === 'green' ? 'flag-green' :
        visual === 'yellow' ? 'flag-yellow' :
        visual === 'completed' || visual === 'red' ? 'flag-red' :
        'flag-gray';

      const stateText =
        displayStatus === 'FLOWN' ? t.operatingNow :
        displayStatus === 'COMPLETED' ? t.completedSector :
        statusLabel(displayStatus);

      updateSectorMap(s.key, displayStatus);

      return `<article class="sector-card premium-sector ${statusClass(displayStatus)} status-${visual}">
        <div class="premium-sector-top">
          <div class="sector-identity">
            <span class="css-flag ${flagClass}" aria-hidden="true"><i></i></span>
            <div>
              <span class="sector-kicker">${t.sectorWord.toUpperCase()} ${s.key}</span>
              <strong>${stateText}</strong>
              <small>📍 ${sectorLocations[s.key]||''}</small>
            </div>
          </div>
          <span class="sector-status-dot status-dot-${visual}"></span>
        </div>

        <div class="sector-message">
          <p>${sectorBody(displayStatus)}</p>
          ${displayStatus==='DELAYED' && delay>0
            ? `<div class="sector-delay-premium"><span>◷</span><div><small>${t.delayLabel}</small><strong>${delay} ${t.minutesShort}</strong></div></div>`
            : ''}
        </div>

        <div class="sector-info-grid">
          <div>
            <span class="info-icon">◷</span>
            <div><small>${t.update}</small><strong>${s.lastUpdate?formatOfficialUpdateTR(s.lastUpdate):'—'}</strong></div>
          </div>
          <div>
            <span class="info-icon">▣</span>
            <div><small>${t.valid}</small><strong>${s.validDateRange?formatOfficialRangeTR(s.validDateRange):'—'}</strong></div>
          </div>
        </div>

        ${displayStatus==='COMPLETED'
          ? `<div class="completed-stop"><span class="mini-red-flag"></span><strong>${t.noFurtherFlights}</strong></div>`
          : ''}
      </article>`;
    }).join('');
  }

  async function load() {
    const msg=document.getElementById('load-message');
    if(msg){msg.className='load-message';msg.textContent=t.loading;}
    try {
      const r=await fetch('/api/flight-status.json',{cache:'no-store'});
      const data=await r.json();
      if(!r.ok||!data.success) throw new Error(data.error||'Status error');
      currentData=data;
      document.getElementById('last-sync-time').textContent=formatOfficialUpdateTR(data.lastUpdate)||'—';
      const trackingUpdate = document.getElementById('tracking-update-time');
      if (trackingUpdate) trackingUpdate.textContent = formatOfficialUpdateTR(data.lastUpdate) || '—';
      renderAlerts(data); renderWeather(data); renderSectors(data);
      if(msg){msg.className='load-message is-hidden';msg.textContent='';}
    } catch(e) {
      console.error(e);
      if(msg){msg.className='load-message is-error';msg.textContent=t.loadError;}
      renderAlerts({status:'PENDING',validDateRange:'',lastUpdate:'',sectors:[],weather:null});
    }
  }
  document.getElementById('refreshBtn')?.addEventListener('click',load);
  load();
  setInterval(load,60000);
})();
</script>

