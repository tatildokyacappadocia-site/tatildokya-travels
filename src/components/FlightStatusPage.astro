.sector-message p{margin:0;color:#617287;font-size:10px;line-height:1.65;min-height:66px}
.sector-delay-premium{display:flex;align-items:center;gap:9px;margin-top:12px;background:#ebf3fd;border:1px solid #87b6ef;border-radius:11px;padding:9px 10px;color:#0b4388}
.sector-delay-premium>span{font-size:18px}.sector-delay-premium small{display:block;font-size:7px;text-transform:uppercase;font-weight:900}.sector-delay-premium strong{display:block;font-size:12px;margin-top:1px}

.sector-info-grid{display:grid;gap:0;border-top:1px solid #e8ecf2;margin:0 15px 0 18px}
.sector-info-grid>div{display:grid;grid-template-columns:20px minmax(0,1fr);gap:7px;align-items:center;padding:9px 0;border-bottom:1px solid #edf0f4}
.sector-info-grid>div:last-child{border-bottom:0}
.info-icon{font-size:15px;color:#1457aa}.sector-info-grid small{display:block;color:#8895a6;font-size:7px;font-weight:900;text-transform:uppercase}.sector-info-grid strong{display:block;color:var(--tbc-navy);font-size:8px;line-height:1.45;margin-top:2px;overflow-wrap:anywhere}

.completed-stop{display:flex;align-items:center;justify-content:center;gap:8px;margin:11px 15px 15px 18px;padding:9px 8px;background:#fff3f4;border:1px solid #efc4c7;border-radius:10px;color:#b62d36;text-align:center}
.completed-stop strong{font-size:8px;text-transform:uppercase;letter-spacing:.025em}
.mini-red-flag{position:relative;width:17px;height:15px;display:block;flex:0 0 17px}
.mini-red-flag::before{content:'';position:absolute;left:1px;top:1px;width:2px;height:13px;background:#c82f39}
.mini-red-flag::after{content:'';position:absolute;left:3px;top:1px;width:12px;height:7px;background:#e34751;clip-path:polygon(0 0,100% 15%,78% 50%,100% 85%,0 100%)}

.sector-overview-card{background:linear-gradient(145deg,#fbfdff,#f6f9fc);border:1px solid #dce4ed;border-radius:17px;padding:14px;box-shadow:0 8px 24px rgba(7,28,54,.04)}
.overview-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}
.overview-head>div span{display:block;font-size:8px;color:#74859a;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.overview-head>div strong{display:block;font:900 13px Montserrat,sans-serif;color:var(--tbc-navy);margin-top:2px}
.overview-live{display:flex;align-items:center;gap:6px;font-size:8px;color:#13744e;font-weight:900}.overview-live i{display:block;width:7px;height:7px;border-radius:50%;background:#1d9c69;box-shadow:0 0 0 4px rgba(29,156,105,.10)}

.sector-map-shell{position:relative;height:295px;border:1px solid #d9e1eb;border-radius:13px;overflow:hidden;background:
  linear-gradient(25deg,transparent 49%,rgba(160,173,188,.12) 50%,transparent 51%) 0 0/65px 65px,
  linear-gradient(-25deg,transparent 49%,rgba(160,173,188,.10) 50%,transparent 51%) 15px 0/75px 75px,
  radial-gradient(circle at 25% 30%,#e8f0f9 0,#e5ecf4 32%,#edf0f3 70%,#eef2f6 100%)}
.sector-map-shell::before,.sector-map-shell::after{content:'';position:absolute;height:3px;background:#bbcfe8;opacity:.85;border-radius:999px;transform-origin:left center}
.sector-map-shell::before{width:115%;left:-8%;top:45%;transform:rotate(-15deg)}.sector-map-shell::after{width:100%;left:6%;top:70%;transform:rotate(11deg)}
.map-watermark{position:absolute;left:14px;bottom:12px;font:900 27px Montserrat,sans-serif;color:rgba(7,28,54,.035);letter-spacing:.08em}
.map-place{position:absolute;z-index:2;font-size:7px;color:#606e80;font-weight:800}.place-avanos{right:14px;top:18px}.place-goreme{left:20px;top:48%}.place-urgup{right:15px;top:46%}.place-nevsehir{left:13px;bottom:42px}

.sector-shape{position:absolute;z-index:4;left:34%;width:50%;height:26%;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2px solid #9ba5b2;background:rgba(156,166,178,.28);color:#23374f;transition:background .25s ease,border-color .25s ease}
.sector-shape span{font:900 12px Montserrat,sans-serif}.sector-shape small{font-size:7px;margin-top:3px;opacity:.8;text-align:center}
.sector-a{top:10%;transform:rotate(-3deg)}.sector-b{top:36%;transform:rotate(1deg)}.sector-c{top:62%;transform:rotate(3deg)}
.map-green{background:rgba(42,192,91,.48);border-color:#159249}.map-yellow{background:rgba(54,137,239,.58);border-color:#1167d1}.map-red{background:rgba(239,74,84,.55);border-color:#d8333d}.map-pending{background:rgba(157,167,180,.32);border-color:#8995a3}

.status-legend{display:grid;grid-template-columns:auto repeat(3,1fr);gap:8px;align-items:center;margin-top:11px;padding:10px 9px;border:1px solid #e1e6ed;background:#fff;border-radius:11px}
.status-legend>strong{font-size:7px;color:#7c8b9d;text-transform:uppercase}.status-legend>div{display:flex;align-items:center;gap:5px}.status-legend b{font-size:7px;color:#42566f;line-height:1.25}
.legend-flag{display:block;width:13px;height:9px;clip-path:polygon(0 0,100% 20%,78% 52%,100% 85%,0 100%)}.legend-flag.is-green{background:#1d9c69}.legend-flag.is-yellow{background:#126ddd}.legend-flag.is-red{background:#e34751}

.cta-box{border:1px solid #6ca1e1;background:#f6fafe;border-radius:16px;padding:20px;text-align:center}.cta-box h2{font:800 19px 'Plus Jakarta Sans',sans-serif;color:var(--tbc-navy);margin:0 0 8px}.cta-box p{font-size:12px;color:#68788b;margin:0 auto 14px;max-width:800px;line-height:1.6}.cta-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}.cta-actions a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;background:#fff;border:1px solid #dbe2ea;color:var(--tbc-navy);border-radius:999px;padding:11px 17px;font-size:10px;font-weight:900}.cta-actions a.wa{background:#21b96f;border-color:#21b96f;color:#fff}.cta-box small{display:block;margin-top:10px;color:#8794a4;font-size:8px}.source-notice{max-width:850px;margin:5px auto 0!important;line-height:1.45;color:#8996a7!important}
.alert-card,.sunrise-card,.weather-card,.sector-card,.cta-box{transition:transform .2s ease,box-shadow .2s ease}.alert-card:hover,.sector-card:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(7,28,54,.07)}

.flight-expert-analysis{margin-top:28px;background:#fff;border:1px solid var(--tbc-line);border-radius:24px;box-shadow:var(--tbc-shadow);padding:38px}
.expert-inner{max-width:900px;margin:auto}
.expert-inner h2{font-size:26px;margin:6px 0 16px;color:var(--tbc-navy)}
.expert-inner h3{font-size:19px;margin:30px 0 10px;color:var(--tbc-navy)}
.expert-inner h4{font-size:15px;margin:0 0 6px;color:var(--tbc-navy)}
.expert-inner p{color:var(--tbc-muted);line-height:1.7;margin:0 0 10px}
.expert-kicker{display:inline-block;font-size:11px;font-weight:900;letter-spacing:.08em;color:var(--tbc-amber);background:var(--tbc-gold-soft);padding:6px 12px;border-radius:999px}
.expert-cta{margin:18px 0}
.expert-cta a{display:inline-block;background:var(--tbc-navy);color:#fff;text-decoration:none;font-weight:800;font-size:13px;padding:11px 20px;border-radius:999px}
.expert-factor-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px;list-style:none;padding:0;margin:12px 0}
.expert-factor-grid li{background:var(--tbc-cream);border:1px solid var(--tbc-line);border-radius:10px;padding:9px 12px;font-size:13px;font-weight:700;color:var(--tbc-navy)}
.expert-source-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin:14px 0}
.expert-source-grid article{background:var(--tbc-cream);border:1px solid var(--tbc-line);border-radius:16px;padding:18px}
.expert-source-grid a{display:block;font-size:12px;font-weight:800;color:var(--tbc-navy-2);text-decoration:none;margin-top:6px}
.expert-source-grid a:hover{text-decoration:underline}
.expert-probability-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:14px 0}
.expert-probability-grid article{border:1px solid var(--tbc-line);border-radius:14px;padding:16px}
.expert-note{font-size:13px;font-style:italic;background:var(--tbc-cream);border-left:3px solid var(--tbc-gold);padding:12px 16px;border-radius:0 10px 10px 0}
.expert-area-tags{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.expert-area-tags span{background:var(--tbc-navy);color:#fff;font-size:12px;font-weight:800;padding:7px 14px;border-radius:999px}
.expert-photo{margin:20px 0;border-radius:18px;overflow:hidden;box-shadow:var(--tbc-shadow)}
.expert-photo img{width:100%;height:auto;display:block;max-height:760px;object-fit:cover;object-position:center 12%;background:var(--tbc-cream)}
.expert-photo figcaption{padding:10px 14px;font-size:12px;color:var(--tbc-muted);background:var(--tbc-cream)}
.expert-map-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:20px 0}
.expert-map{border:1px solid var(--tbc-line);border-radius:16px;overflow:hidden}
.expert-map img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;display:block;background:var(--tbc-cream)}
.expert-map figcaption{padding:12px 14px;font-size:12px;color:var(--tbc-muted)}
.expert-map figcaption strong{display:block;color:var(--tbc-navy);margin-bottom:4px}
.expert-map .unofficial-badge{color:var(--tbc-red)!important}
.expert-map figcaption ul{margin:6px 0 0;padding-left:16px}
.expert-pilot-card{background:var(--tbc-cream);border:1px solid var(--tbc-line);border-radius:18px;padding:22px;margin:14px 0}
.expert-comparison-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:13px}
.expert-comparison-table td{padding:11px 14px;border-bottom:1px solid var(--tbc-line);color:var(--tbc-navy)}
.expert-comparison-table td:last-child{color:var(--tbc-muted);text-align:right}
.expert-disclaimer{margin-top:30px;background:var(--tbc-navy);color:#fff;border-radius:18px;padding:26px}
.expert-disclaimer h3{color:#fff;margin-top:0}
.expert-disclaimer-sub{font-weight:800;color:var(--tbc-gold-soft)}
.expert-disclaimer p{color:#cfdae8}
.expert-signature{margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,.15);display:flex;flex-direction:column;gap:2px;font-size:13px}
.expert-signature strong{font-size:16px}
.expert-related{margin-top:26px}
.expert-related div{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.expert-related a{border:1px solid var(--tbc-line);border-radius:999px;padding:9px 16px;font-size:12px;font-weight:800;color:var(--tbc-navy);text-decoration:none}
.expert-related a:hover{background:var(--tbc-cream)}
@media(max-width:700px){.expert-map-grid{grid-template-columns:1fr}}
.flight-status-seo{margin-top:28px;background:#fff;border:1px solid var(--tbc-line);border-radius:24px;box-shadow:var(--tbc-shadow);padding:38px}
.seo-inner{max-width:1040px;margin:0 auto}
.seo-kicker{display:inline-flex;background:var(--tbc-gold-soft);border:1px solid #8db7ea;color:#0b4183;border-radius:999px;padding:7px 11px;font-size:9px;font-weight:900;letter-spacing:.07em}
.flight-status-seo h2{font:900 clamp(26px,3vw,36px)/1.2 Montserrat,'Plus Jakarta Sans',sans-serif;color:var(--tbc-navy);letter-spacing:-.03em;margin:16px 0 14px}
.flight-status-seo>div>p,.seo-grid p,.flight-faq p{color:#586a80;font-size:14px;line-height:1.8}
.flight-status-seo>div>p{margin:0 0 14px}
.seo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:25px 0}
.seo-grid article{background:#fbfcfe;border:1px solid #e1e6ed;border-radius:15px;padding:19px}
.seo-grid h3{font:800 17px/1.4 'Plus Jakarta Sans',sans-serif;color:var(--tbc-navy);margin:0 0 9px}
.seo-grid p{margin:0}
.seo-official-note{margin:24px 0;background:#eaf3fd;border:1px solid #8db7ea;border-left:4px solid var(--tbc-gold);border-radius:13px;padding:15px 17px;color:#61738a;font-size:12px;line-height:1.65}
.seo-official-note strong{color:var(--tbc-navy)}
.flight-status-seo .faq-title{font-size:26px;margin-top:31px}
.flight-faq{display:grid;gap:10px}
.flight-faq details{background:#fbfcfe;border:1px solid #e0e6ed;border-radius:13px;padding:0 16px}
.flight-faq details[open]{background:#fff}
.flight-faq summary{cursor:pointer;list-style:none;padding:16px 28px 16px 0;color:var(--tbc-navy);font-size:13px;font-weight:800;position:relative}
.flight-faq summary::-webkit-details-marker{display:none}
.flight-faq summary::after{content:'+';position:absolute;right:2px;top:13px;width:22px;height:22px;display:grid;place-items:center;border-radius:50%;background:#eaf3fd;color:#0a4082;font-size:15px}
.flight-faq details[open] summary::after{content:'–'}
.flight-faq p{margin:0;padding:0 0 16px}


@media(max-width:1100px){
  .tracking-layout{grid-template-columns:1fr}
  .sector-overview-card{display:grid;grid-template-columns:minmax(260px,.65fr) 1fr;gap:12px}
  .overview-head,.status-legend{grid-column:1}
  .sector-map-shell{grid-column:2;grid-row:1/3;height:270px}
}
@media(max-width:900px){
  .weather-card{padding:17px;border-radius:18px}.weather-live-dot{align-self:flex-start}
  .weather-head{align-items:flex-start;flex-direction:column}
  .weather-grid{grid-template-columns:repeat(2,1fr)}
  .weather-grid>div:last-child{grid-column:span 2}
  .tracking-head{align-items:flex-start;flex-direction:column}.tracking-update{width:100%}
  .tracking-layout{grid-template-columns:1fr}
  .sector-grid{grid-template-columns:1fr}
  .sector-overview-card{display:block;padding:12px}
  .sector-map-shell{height:300px;margin-top:10px}
  .status-legend{grid-template-columns:1fr;gap:7px}
  .status-legend>strong{margin-bottom:2px}
}

@media(max-width:900px){.tbc-header nav{display:none}.tbc-header{height:72px;padding:0 16px}.tbc-brand img{width:48px;height:48px}.tbc-page{width:min(100% - 16px,1180px)}.status-shell{padding:17px;border-radius:18px}.feed-header{grid-template-columns:1fr}.sync-badge{white-space:normal}.alerts-grid,.sunrise-grid,.sector-grid{grid-template-columns:1fr}.weather-head{align-items:flex-start;flex-direction:column}.weather-grid{grid-template-columns:repeat(2,1fr)}.weather-grid>div:last-child{grid-column:span 2}.sector-meta{grid-template-columns:1fr}.alert-meta>div{grid-template-columns:1fr}.cta-actions{flex-direction:column}.cta-actions a{width:100%}}
@media(max-width:900px){.flight-status-seo{padding:22px 17px;border-radius:18px}.seo-grid{grid-template-columns:1fr}.flight-expert-analysis{padding:22px 17px;border-radius:18px}}

/* Weather snapshot: compact premium strip above Göreme Sunrise */
.weather-card{margin:0 0 14px!important;padding:14px 16px!important;border-radius:18px!important;background:linear-gradient(110deg,#f8fbfe 0%,#fff 44%,#f8fbfe 100%)!important;box-shadow:0 8px 24px rgba(7,28,54,.055)!important}
.weather-head{padding-bottom:10px!important;margin-bottom:10px!important}
.weather-icon{width:42px!important;height:42px!important;font-size:23px!important;border-radius:13px!important}
.weather-eyebrow{font-size:8px!important;letter-spacing:.1em!important}
.weather-title h2{font-size:17px!important;margin:2px 0!important}
.weather-title small{font-size:9px!important}
.weather-grid{gap:8px!important}
.weather-grid>div{min-height:58px!important;padding:10px 12px!important;border-radius:13px!important}
.weather-grid span{font-size:8px!important}
.weather-grid strong{font-size:15px!important}
.weather-note{margin:9px 0 0!important;padding-top:8px!important;font-size:9px!important;line-height:1.45!important}
.weather-live-dot{font-size:8px!important;padding:6px 9px!important}

.cancellation-seo{margin-top:34px;padding-top:30px;border-top:1px solid var(--tbc-line)}
.cancellation-seo>h2{font:800 clamp(24px,3vw,32px)/1.2 Montserrat,'Plus Jakarta Sans',sans-serif;letter-spacing:-.025em;margin:0 0 14px}
.cancellation-seo>h3,.cancellation-tours h3{font-size:20px;margin:28px 0 10px}
.cancellation-seo p{color:var(--tbc-muted);line-height:1.75}
.cancellation-factor-grid,.cancellation-help-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:16px}
.cancellation-factor-grid article,.cancellation-help-grid article,.cancellation-tours{border:1px solid var(--tbc-line);border-radius:16px;background:#fff;padding:18px}
.cancellation-factor-grid h4,.cancellation-help-grid h4{margin:0 0 7px;font-size:14px}
.cancellation-factor-grid p,.cancellation-help-grid p{margin:0;font-size:13px}
.cancellation-tours{margin-top:22px;background:linear-gradient(135deg,#f8fbfe,#f9fbfe)}
.cancellation-tours h3{margin-top:0}
.cancellation-tours>div{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.cancellation-tours a{display:inline-flex;padding:11px 14px;border-radius:12px;background:var(--tbc-navy);color:#fff;text-decoration:none;font-size:12px;font-weight:800}
@media(max-width:760px){.cancellation-factor-grid,.cancellation-help-grid{grid-template-columns:1fr}.weather-card{padding:12px!important}}



/* =========================================================
   FINAL MORNING DASHBOARD + OFFICIAL-STYLE SECTOR MAP
   ========================================================= */

.morning-dashboard{
  display:grid;
  grid-template-columns:minmax(0,1.18fr) minmax(230px,.91fr) minmax(230px,.91fr);
