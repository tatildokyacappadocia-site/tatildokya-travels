---
import articles from "../data/legacy-seo-articles.json";
import GoogleAdsTag from './GoogleAdsTag.astro';

const { lang = "en" } = Astro.props;
const supported = ["en", "tr", "es"];
if (!supported.includes(lang)) return new Response("Not found", { status: 404 });

const copy = {
  en: {
    eyebrow: "CAPPADOCIA TRAVEL JOURNAL",
    title: "Cappadocia Travel Guides",
    description: "Practical Cappadocia travel guides covering hot air balloon flights, balloon prices, daily tours, weather planning and local experiences.",
    balloon: "Balloon Tours", tours: "Cappadocia Tours", status: "Flight Status",
    activities: "Activities", private: "Private Tours", transfers: "Transfers",
    read: "Read guide", emptyTitle: "Spanish guides are being prepared",
    emptyText: "Our localized Spanish travel guides will be published here after editorial review. In the meantime, explore our live tours and flight-status pages.",
    explore: "Explore Cappadocia Tours", badge: "TRAVEL GUIDES", score: "Guide",
    footer: "Local Cappadocia travel planning, balloon information and daily tour guides."
  },
  tr: {
    eyebrow: "KAPADOKYA SEYAHAT GÜNLÜĞÜ",
    title: "Kapadokya Gezi Rehberleri",
    description: "Sıcak hava balonu uçuşları, balon turu fiyatları, günlük turlar, hava durumu planlaması ve yerel deneyimler için güncel Kapadokya rehberleri.",
    balloon: "Balon Turları", tours: "Kapadokya Turları", status: "Uçuş Durumu",
    activities: "Aktiviteler", private: "Özel Turlar", transfers: "Transferler",
    read: "Rehberi oku", emptyTitle: "Yeni Türkçe rehberler hazırlanıyor",
    emptyText: "Editoryal kontrolden geçen yeni Türkçe Kapadokya rehberleri burada yayınlanacaktır.",
    explore: "Kapadokya Turlarını İncele", badge: "SEYAHAT REHBERLERİ", score: "Rehber",
    footer: "Kapadokya seyahat planlaması, balon bilgileri ve günlük tur rehberleri."
  },
  es: {
    eyebrow: "DIARIO DE VIAJE DE CAPADOCIA",
    title: "Guías de Viaje de Capadocia",
    description: "Guías prácticas de Capadocia sobre vuelos en globo aerostático, precios, excursiones diarias, planificación según el clima y experiencias locales.",
    balloon: "Tours en Globo", tours: "Tours de Capadocia", status: "Estado de Vuelos",
    activities: "Actividades", private: "Tours Privados", transfers: "Traslados",
    read: "Leer guía", emptyTitle: "Estamos preparando las guías en español",
    emptyText: "Las guías localizadas en español se publicarán aquí después de una revisión editorial. Mientras tanto, consulta nuestros tours y el estado de los vuelos.",
    explore: "Explorar Tours de Capadocia", badge: "GUÍAS DE VIAJE", score: "Guía",
    footer: "Planificación de viajes en Capadocia, información de globos y guías de excursiones."
  }
}[lang];

const list = (articles as any[])
  .filter((a) => a.lang === lang)
  .sort((a,b) => Number(b.oldRankMathScore || 0) - Number(a.oldRankMathScore || 0));

const origin = "https://www.tatildokya.com";
const canonical = `${origin}/${lang}/blog/`;
const alternate = (l) => `${origin}/${l}/blog/`;

const schema = {
  "@context":"https://schema.org",
  "@type":"CollectionPage",
  name: copy.title,
  description: copy.description,
  url: canonical,
  inLanguage: lang,
  isPartOf: { "@type":"WebSite", name:"Tatildokya Travels", url:origin },
  mainEntity: {
    "@type":"ItemList",
    itemListElement:list.map((a,i)=>({
      "@type":"ListItem", position:i+1, name:a.title,
      url: a.newPath ? `${origin}${a.newPath}` : canonical
    }))
  }
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{copy.title} | Tatildokya Travels</title>
  <meta name="description" content={copy.description}/>
  <meta name="robots" content="index,follow,max-image-preview:large"/>
  <!-- Tatildokya Travels favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=11" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=11" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=11" />
  <link rel="shortcut icon" href="/favicon.ico?v=11" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=11" />
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang="en" href={alternate("en")}/>
  <link rel="alternate" hreflang="tr" href={alternate("tr")}/>
  <link rel="alternate" hreflang="es" href={alternate("es")}/>
  <link rel="alternate" hreflang="x-default" href={alternate("en")}/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={copy.title}/>
  <meta property="og:description" content={copy.description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:site_name" content="Tatildokya Travels"/>
  <meta property="og:image" content={`${origin}/images/logo/tatildokya-travels.webp`}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={copy.title}/>
  <meta name="twitter:description" content={copy.description}/>
  <meta name="twitter:image" content={`${origin}/images/logo/tatildokya-travels.webp`}/>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <style>
    :root{--navy:#0b3c78;--gold:#1d79ea;--cream:#f4f7fb;--ink:#324e71;--muted:#78889c;--line:#dce2ea}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;font-family:'Plus Jakarta Sans',Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:
      radial-gradient(circle at 7% 4%,rgba(38,128,238,.08),transparent 25%),linear-gradient(180deg,#f4f7fb,#f2f5fa);color:var(--ink)}
    a{text-decoration:none}.shell{width:min(1080px,calc(100% - 36px));margin:auto}
    .top{background:#fff;border-bottom:1px solid #eef2f5;position:sticky;top:0;z-index:30}
    .hero{padding:22px 0 18px}.heroCard{position:relative;overflow:hidden;border-radius:23px;padding:32px 30px 28px;background:#fff;border:1px solid var(--line);box-shadow:0 14px 34px rgba(11,60,120,.055)}
    .heroCard:after{content:"";position:absolute;left:30px;right:30px;bottom:0;height:1px;background:linear-gradient(90deg,var(--gold),#dce4ed)}
    .eyebrow{position:relative;display:inline-flex;padding:7px 12px;border-radius:999px;background:var(--gold);color:#2d3b4d;font-size:9px;font-weight:950;letter-spacing:.1em}
    h1{position:relative;color:var(--navy);font-size:clamp(30px,4vw,42px);line-height:1.08;letter-spacing:-.035em;margin:14px 0 9px;max-width:780px}
    .lead{position:relative;max-width:780px;color:var(--muted);font-size:13.5px;line-height:1.8;margin:0}
    .quick{position:relative;display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.quick a{padding:10px 14px;border-radius:999px;background:#fff;color:var(--navy);border:1px solid #e5ebf1;font-size:11px;font-weight:900}.quick a:last-child{background:#e9f2fd;border-color:#6aa3e9}
    .sectionHead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:24px 0 14px}.sectionHead h2{color:var(--navy);font-size:24px;margin:0;letter-spacing:-.025em}.sectionHead p{margin:0;color:var(--muted);font-size:11px}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding-bottom:58px}
    .card{display:flex;flex-direction:column;min-height:240px;background:#fff;border:1px solid var(--line);border-radius:19px;padding:22px;color:inherit;box-shadow:0 9px 24px rgba(11,60,120,.04);transition:.2s ease}
    .card:hover{transform:translateY(-3px);border-color:#669fe6;box-shadow:0 14px 32px rgba(11,60,120,.075)}
    .meta{font-size:9px;font-weight:950;color:#0e5bb8;letter-spacing:.08em;text-transform:uppercase}.card h2{font-size:19px;line-height:1.3;color:var(--navy);margin:10px 0}.card p{font-size:12.5px;line-height:1.72;color:var(--muted);margin:0}
    .kw{margin-top:auto;padding-top:17px;color:#93a0ae;font-size:9.5px}.read{margin-top:11px;color:var(--navy);font-size:11px;font-weight:950}
    .empty{grid-column:1/-1;background:#fff;border:1px solid var(--line);border-radius:21px;padding:36px;text-align:center}.empty h2{color:var(--navy);margin:0 0 8px}.empty p{max-width:680px;margin:0 auto 18px;color:var(--muted);line-height:1.7}.empty a{display:inline-flex;background:var(--gold);color:#082b56;font-weight:900;padding:12px 16px;border-radius:999px}
    footer{background:#fff;border-top:1px solid #f0f3f6;color:#78879a;padding:27px 0;text-align:center;font-size:11px}
    @media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}
    .uh-header{position:sticky;top:0;z-index:1200;background:#fff;border-bottom:1px solid #f1f4f9}
    .uh-header .header-container{max-width:1320px;height:88px;margin:auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:18px}
    .uh-header .logo,.uh-header .head-right,.uh-header .insta,.uh-header .wa-head{display:flex;align-items:center}
    .uh-header .logo>a:first-child img{width:auto!important;height:70px!important;max-width:145px!important;object-fit:contain!important;display:block}
    .uh-header .insta{gap:6px;margin-left:12px;padding:7px 10px;border:1px solid #f5f7fa;border-radius:99px;text-decoration:none;color:#405a7b;font-size:10px;font-weight:700}
    .uh-header .insta img,.uh-header .wa-head img{width:20px;height:20px;object-fit:contain}
    .uh-header nav.uh-nav{display:flex;gap:20px}
    .uh-header nav.uh-nav a{font-size:12px;font-weight:800;color:#142d4a;text-decoration:none}
    .uh-header .head-right{gap:12px}
    .uh-header .wa-head{gap:6px;color:#142d4a;text-decoration:none;font-weight:800;font-size:12px}
    .uh-header .lang{position:relative}
    .uh-header .lang button{border:1px solid #d5dde7;background:#f4f7fa;border-radius:99px;padding:7px 12px;font-weight:800;font-size:12px;white-space:nowrap;display:inline-flex;align-items:center;gap:4px}
    .uh-header .lang>div{display:none;position:absolute;right:0;top:42px;background:#fff;border:1px solid #ecf0f5;border-radius:12px;padding:6px;min-width:150px;box-shadow:0 14px 30px #0002}
    .uh-header .lang.open>div{display:grid}
    .uh-header .lang>div a{padding:8px;text-decoration:none;color:#0c3364;border-radius:8px}
    .uh-header .lang>div a:hover{background:#f4f7fa}
    .uh-header .menu-burger{display:none;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;border:1px solid #d5dde7;background:#f4f7fa;border-radius:10px;cursor:pointer;padding:0}
    .uh-header .menu-burger span{display:block;width:18px;height:2px;margin:0 auto;background:#142d4a;border-radius:2px;transition:transform .2s ease,opacity .2s ease}
    .uh-header .menu-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .uh-header .menu-burger.open span:nth-child(2){opacity:0}
    .uh-header .menu-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
    .uh-mobile-nav{display:none;flex-direction:column;background:#fff;border-top:1px solid #f1f4f9;box-shadow:0 14px 30px rgba(27,49,76,.08)}
    .uh-mobile-nav.open{display:flex}
    .uh-mobile-nav a{text-decoration:none;color:#142d4a;font-size:14px;font-weight:800;padding:15px 18px;border-bottom:1px solid #f5f7fa}
    .uh-mobile-nav a:last-child{border-bottom:0}
    @media(min-width:1001px){.uh-mobile-nav{display:none!important}}
    @media(max-width:1000px){.uh-header nav.uh-nav{display:none}.uh-header .menu-burger{display:flex}}
    @media(max-width:600px){.uh-header .header-container{height:76px}.uh-header .logo>a:first-child img{height:60px!important;max-width:125px!important}.uh-header .insta{margin-left:6px;padding:6px 9px;gap:5px}.uh-header .insta span{font-size:9px}.uh-header .lang button{padding:6px 9px;font-size:11px}.uh-header .wa-head{font-size:0}}
    @media(max-width:420px){.uh-header .insta span{display:none}}

    @media(max-width:620px){.shell{width:min(100% - 24px,1080px)}.hero{padding-top:16px}.heroCard{padding:25px 20px;border-radius:20px}.heroCard:after{left:20px;right:20px}h1{font-size:30px}.lead{font-size:13px}.grid{grid-template-columns:1fr}.sectionHead{align-items:start;flex-direction:column}.card{min-height:215px}}
  
/* TOUR DETAIL VISUAL SYSTEM — information pages (no price/calendar/booking UI) */
:root{--tbc-navy:#123561;--tbc-navy2:#204b82;--tbc-gold:#0f5dbc;--tbc-bg:#f4f7fa;--tbc-surface:#fff;--tbc-border:#e8eff8;--tbc-text:#1a395e;--tbc-muted:#73859a}
body{background:radial-gradient(circle at 10% 0%,rgba(15,93,188,.08),transparent 28%),radial-gradient(circle at 90% 8%,rgba(32,75,130,.05),transparent 26%),var(--tbc-bg)!important;color:var(--tbc-text)!important}
.wrap,.shell{max-width:1240px!important;width:min(1240px,calc(100% - 32px))!important;margin-left:auto!important;margin-right:auto!important}
main .wrap{padding-top:20px!important}
.crumb{font-size:14px!important;margin-bottom:20px!important;color:#73859a!important;font-weight:600!important}.crumb a{color:var(--tbc-navy)!important}.crumb span{color:var(--tbc-gold)!important}
.hero,.heroCard{border-radius:24px!important;padding:40px 36px!important;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(241,247,253,.96))!important;border:1px solid var(--tbc-border)!important;box-shadow:0 14px 34px rgba(18,53,97,.08)!important;color:var(--tbc-text)!important;overflow:hidden!important}
.hero:after,.heroCard:after{content:none!important}
.hero>span,.hero .eyebrow,.heroCard .eyebrow{display:inline-flex!important;align-items:center!important;min-height:30px!important;padding:0 14px!important;border-radius:999px!important;background:var(--tbc-gold)!important;color:var(--tbc-navy)!important;font-size:11px!important;font-weight:800!important;letter-spacing:.08em!important;text-transform:uppercase!important;box-shadow:0 5px 14px rgba(15,93,188,.18)!important}
.hero h1,.heroCard h1{margin:14px 0 12px!important;font-size:38px!important;line-height:1.15!important;font-weight:800!important;letter-spacing:-.02em!important;color:var(--tbc-navy)!important}
.hero p,.heroCard .lead{max-width:960px!important;font-size:15px!important;line-height:1.8!important;color:#53657b!important;margin:0!important}
.card,.contact-card,.info-main,.social-card,.faq{background:#fff!important;border:1px solid var(--tbc-border)!important;box-shadow:0 14px 34px rgba(18,53,97,.07)!important}
.card{border-radius:28px!important;padding:32px!important;margin-top:24px!important}.card h2,.info-main h2,.social-card h3{color:var(--tbc-navy)!important;font-size:26px!important}.card>p,.bullet p,.info-row p,.answer p{font-size:15px!important;line-height:1.95!important;color:var(--tbc-muted)!important}
.contact-grid{gap:18px!important;margin-top:24px!important}.contact-card{border-radius:24px!important;padding:22px!important}.info-panel{gap:24px!important;margin-top:24px!important}.info-main,.social-card{border-radius:28px!important;padding:32px!important}
.faq-list{gap:14px!important;margin-top:24px!important}.faq{border-radius:22px!important}.faq[open]{border-color:#5899ea!important;box-shadow:0 14px 34px rgba(18,53,97,.09)!important}summary{padding:20px 22px!important;font-size:15px!important}summary i{background:var(--tbc-navy)!important;color:var(--tbc-gold)!important}
@media(max-width:850px){.wrap,.shell{width:min(100% - 24px,1240px)!important}.hero,.heroCard{padding:28px 22px!important}.hero h1,.heroCard h1{font-size:30px!important}.card,.info-main,.social-card{padding:24px!important}}


/* Blog-specific alignment with tour detail layout */
.hero{padding:22px 0 18px!important;background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important}
.heroCard{padding:40px 36px!important}
.grid .card{margin-top:0!important;border-radius:24px!important;padding:24px!important;min-height:240px!important}
.grid .card h2{font-size:19px!important;color:var(--tbc-navy)!important}
.grid .card p{font-size:13px!important;line-height:1.8!important;color:var(--tbc-muted)!important}
.sectionHead h2{color:var(--tbc-navy)!important}
</style>
<GoogleAdsTag />
</head>
<body>
<header class="top uh-header">
  <div class="shell header-container">
    <div class="logo"><a href={`/${lang}/`}><img src="/images/logo/tatildokya-travels.webp" alt="Tatildokya Travels" width="600" height="200"/></a><a class="insta" href="https://www.instagram.com/tatildokyatravel/" target="_blank" rel="noopener"><img src="/images/icons/instagram-logo.webp" alt="" width="24" height="24" loading="lazy"/><span>@tatildokyatravel</span></a></div>
    <nav class="uh-nav" aria-label="Blog navigation">
      <a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a>
      <a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a>
      <a href={`/${lang}/activities/`}>{copy.activities}</a>
      <a href={`/${lang}/private-tours/`}>{copy.private}</a>
      <a href={`/${lang}/transfers/`}>{copy.transfers}</a>
      
    </nav>
    <div class="head-right"><div class="lang"><button type="button" id="langBtn">{lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧'} {lang.toUpperCase()} ▾</button><div><a href="/en/blog/">🇬🇧 English</a><a href="/tr/blog/">🇹🇷 Türkçe</a><a href="/es/blog/">🇪🇸 Español</a></div></div><a class="wa-head" href="https://wa.me/905333925450" target="_blank" rel="noopener"><img src="/images/icons/whatsapp-logo.webp" alt="" width="24" height="24" loading="lazy"/>WhatsApp</a><button type="button" class="menu-burger" aria-label="Toggle menu" aria-expanded="false"><span></span><span></span><span></span></button></div>
  </div>
  <nav class="uh-mobile-nav">
    <a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a>
    <a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a>
    <a href={`/${lang}/activities/`}>{copy.activities}</a>
    <a href={`/${lang}/private-tours/`}>{copy.private}</a>
    <a href={`/${lang}/transfers/`}>{copy.transfers}</a>
    
  </nav>
</header>

<main>
  <section class="hero"><div class="shell"><div class="heroCard">
    <span class="eyebrow">{copy.eyebrow}</span>
    <h1>{copy.title}</h1>
    <p class="lead">{copy.description}</p>
    <div class="quick">
      <a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a>
      
      <a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a>
    </div>
  </div></div></section>

  <section class="shell">
    <div class="sectionHead"><h2>{copy.badge}</h2><p>{list.length ? `${list.length} ${copy.score.toLowerCase()}` : ""}</p></div>
    <div class="grid">
      {list.length ? list.map((a)=>
        <a class="card" href={a.newPath}>
          <div class="meta">{copy.score}</div>
          <h2>{a.title}</h2>
          <p>{a.description}</p>
          <div class="kw">{a.focusKeyword || ""}</div>
          <div class="read">{copy.read} →</div>
        </a>
      ) :
        <div class="empty">
          <h2>{copy.emptyTitle}</h2>
          <p>{copy.emptyText}</p>
          <a href={`/${lang}/cappadocia-tours/`}>{copy.explore}</a>
        </div>
      }
    </div>
  </section>
</main>
<footer><div class="shell">© 2026 Tatildokya Travels · {copy.footer}</div></footer>
<script is:inline>
  document.querySelectorAll('.uh-header .lang').forEach((wrap) => {
    const btn = wrap.querySelector('button');
    const menu = wrap.querySelector('div:last-child');
    btn?.addEventListener('click', (e) => { e.stopPropagation(); wrap.classList.toggle('open'); });
    document.addEventListener('click', () => wrap.classList.remove('open'));
  });
  const shBurger = document.querySelector('.uh-header .menu-burger');
  const shMobileNav = document.querySelector('.uh-mobile-nav');
  shBurger?.addEventListener('click', () => {
    const isOpen = shMobileNav?.classList.toggle('open');
    shBurger.classList.toggle('open', !!isOpen);
    shBurger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
  shMobileNav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      shMobileNav.classList.remove('open');
      shBurger?.classList.remove('open');
      shBurger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
</body>
</html>
