# Supabase (public browser-safe project URL/key)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy fallback only; prefer PUBLIC_SUPABASE_PUBLISHABLE_KEY.
PUBLIC_SUPABASE_ANON_KEY=

# Reservation email notifications (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tatildokya Travels <info@example.com>

# Optional WhatsApp notification integration (server-side only)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
